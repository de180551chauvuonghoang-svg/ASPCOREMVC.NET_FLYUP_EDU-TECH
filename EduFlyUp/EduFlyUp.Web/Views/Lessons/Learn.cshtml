@model EduFlyUp.Web.Models.Lessons.LearnLessonViewModel

@{
    ViewData["Title"] = $"{Model.CurrentLesson.Title} - {Model.Course.Title}";
    ViewData["FullWidth"] = true;
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
}

<div class="learning-classroom d-flex flex-column vh-100 overflow-hidden" style="background-color: #0b0f19; color: #f8fafc;">
    
    <!-- Top Learning Header (Coursera Style) -->
    <header class="learning-header px-3 px-md-4 py-2 d-flex align-items-center justify-content-between border-bottom" 
            style="background: #111827; border-color: rgba(255, 255, 255, 0.08) !important; height: 64px; z-index: 1030;">
        
        <!-- Left: Back to My Courses & Course Title -->
        <div class="d-flex align-items-center gap-3 overflow-hidden">
            <a asp-controller="Courses" asp-action="MyCourses" class="btn btn-outline-secondary btn-sm rounded-pill text-white border-secondary-subtle px-3 py-1.5 d-flex align-items-center gap-1.5 shadow-none" 
               title="Quay lại khóa học của tôi" style="background: rgba(255, 255, 255, 0.05); font-size: 0.85rem;">
                <i class="bi bi-chevron-left"></i>
                <span class="d-none d-sm-inline">Khóa học của tôi</span>
            </a>

            <div class="vr bg-secondary opacity-25 d-none d-sm-block" style="height: 24px;"></div>

            <div class="d-flex flex-column text-truncate">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill align-self-start mb-0 px-2 py-0.5 d-none d-md-inline-block" style="font-size: 0.7rem;">
                    @Model.Course.Title
                </span>
                <span class="fw-bold text-white text-truncate mt-0.5" style="font-size: 0.95rem;" title="@Model.CurrentLesson.Title">
                    Bài @Model.CurrentLessonIndex: @Model.CurrentLesson.Title
                </span>
            </div>
        </div>

        <!-- Right: Course Progress & Next/Prev Navigation -->
        <div class="d-flex align-items-center gap-2 gap-md-3">
            <!-- Progress Pill -->
            <div class="d-none d-lg-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="progress" style="width: 80px; height: 6px; background-color: rgba(255, 255, 255, 0.15);">
                    <div id="courseProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%;"></div>
                </div>
                <span id="courseProgressText" class="small fw-semibold text-slate-300" style="font-size: 0.78rem;">0% hoàn thành</span>
            </div>

            <!-- Previous Lesson Button -->
            @if (Model.PreviousLesson != null)
            {
                <a asp-action="Learn" asp-route-id="@Model.PreviousLesson.Id" class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                   style="width: 38px; height: 38px; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.1);" 
                   title="Bài trước: @Model.PreviousLesson.Title">
                    <i class="bi bi-chevron-left text-white"></i>
                </a>
            }
            else
            {
                <button class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center opacity-25" 
                        style="width: 38px; height: 38px; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.1);" disabled>
                    <i class="bi bi-chevron-left text-white"></i>
                </button>
            }

            <!-- Next Lesson Button -->
            @if (Model.NextLesson != null)
            {
                <a asp-action="Learn" asp-route-id="@Model.NextLesson.Id" class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                   style="width: 38px; height: 38px; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.1);" 
                   title="Bài tiếp theo: @Model.NextLesson.Title">
                    <i class="bi bi-chevron-right text-white"></i>
                </a>
            }
            else
            {
                <button class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center opacity-25" 
                        style="width: 38px; height: 38px; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.1);" disabled>
                    <i class="bi bi-chevron-right text-white"></i>
                </button>
            }

            <!-- Toggle Sidebar Button (For full screen focus mode) -->
            <button id="toggleCurriculumBtn" class="btn btn-brand btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 ms-1" 
                    title="Đóng / Mở danh sách bài giảng">
                <i class="bi bi-layout-sidebar-reverse"></i>
                <span class="d-none d-md-inline" id="curriculumBtnText">Bài giảng</span>
            </button>
        </div>
    </header>

    <!-- Main Workspace (2 Columns: Main Stage + Curriculum Sidebar) -->
    <div class="learning-workspace d-flex flex-grow-1 overflow-hidden position-relative">
        
        <!-- Center Stage (Video + Tabs) -->
        <div id="learningMainStage" class="stage-container flex-grow-1 overflow-y-auto" style="scroll-behavior: smooth;">
            
            <!-- Video Player Area -->
            <div class="video-container-wrapper bg-black position-relative" style="background: #000000; box-shadow: inset 0 0 30px rgba(0,0,0,0.8);">
                <div class="container-fluid px-0 px-lg-4 py-0 py-lg-3" style="max-width: 1200px;">
                    <div class="ratio ratio-16x9 rounded-0 rounded-lg-4 overflow-hidden shadow-2xl position-relative" style="background: #0f172a;">
                        
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentLesson.VideoUrl))
                        {
                            @if (Model.IsYoutubeVideo())
                            {
                                <iframe src="@Model.GetEmbedVideoUrl()" 
                                        title="@Model.CurrentLesson.Title" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                        allowfullscreen 
                                        class="w-100 h-100 border-0"></iframe>
                            }
                            else
                            {
                                <video id="mainVideoPlayer" controls controlsList="nodownload" preload="metadata" class="w-100 h-100" style="object-fit: contain;">
                                    <source src="@Model.CurrentLesson.VideoUrl" type="video/mp4">
                                    Trình duyệt của bạn không hỗ trợ phát thẻ video HTML5.
                                </video>
                            }
                        }
                        else
                        {
                            <!-- Fallback for Text-based or upcoming lesson -->
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4" 
                                 style="background: radial-gradient(circle at center, #1e1b4b 0%, #0f172a 100%);">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 shadow" 
                                     style="width: 80px; height: 80px; background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.4); color: #818cf8;">
                                    <i class="bi bi-book-half fs-1"></i>
                                </div>
                                <h4 class="text-white fw-bold mb-2">Bài đọc & Hướng dẫn thực hành</h4>
                                <p class="text-slate-400 small mb-0" style="max-width: 480px; color: #94a3b8;">
                                    Bài học này được biên soạn dạng văn bản tài liệu và mã nguồn hướng dẫn chi tiết bên dưới.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Controls Bar (Under Video) -->
            <div class="bg-dark px-3 px-md-4 py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3" 
                 style="background: #111827 !important; border-color: rgba(255, 255, 255, 0.08) !important;">
                
                <div class="d-flex align-items-center gap-3">
                    <!-- Complete Checkbox Button -->
                    <button id="markCompletedBtn" class="btn btn-outline-success rounded-pill px-3 py-2 d-flex align-items-center gap-2 btn-sm fw-semibold shadow-sm transition-all">
                        <i class="bi bi-check2-circle fs-5" id="completeIcon"></i>
                        <span id="completeText">Đánh dấu đã hoàn thành</span>
                    </button>

                    @if (Model.CurrentLesson.IsPreview)
                    {
                        <span class="badge rounded-pill px-3 py-1.5 text-info" style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3);">
                            <i class="bi bi-unlock-fill me-1"></i>Học thử miễn phí
                        </span>
                    }
                </div>

                <!-- Next/Prev Buttons -->
                <div class="d-flex align-items-center gap-2">
                    @if (Model.PreviousLesson != null)
                    {
                        <a asp-action="Learn" asp-route-id="@Model.PreviousLesson.Id" class="btn btn-secondary rounded-pill btn-sm px-3 py-2 d-inline-flex align-items-center gap-1.5" 
                           style="background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.15);">
                            <i class="bi bi-arrow-left"></i>
                            <span>Bài trước</span>
                        </a>
                    }
                    
                    @if (Model.NextLesson != null)
                    {
                        <a asp-action="Learn" asp-route-id="@Model.NextLesson.Id" class="btn btn-brand rounded-pill btn-sm px-4 py-2 d-inline-flex align-items-center gap-1.5 shadow-glow">
                            <span>Bài kế tiếp</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Courses" asp-action="MyCourses" class="btn btn-success rounded-pill btn-sm px-4 py-2 d-inline-flex align-items-center gap-1.5 shadow-sm">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>Hoàn thành khóa học!</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Tabbed Content Section (Coursera Style Tabs) -->
            <div class="container-fluid px-3 px-md-5 py-4" style="max-width: 1200px;">
                
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs border-bottom mb-4" id="learningTab" role="tablist" style="border-color: rgba(255, 255, 255, 0.12) !important;">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active text-white fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 border-0 position-relative" 
                                id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-content" type="button" role="tab" style="background: transparent;">
                            <i class="bi bi-file-earmark-text text-primary"></i>
                            <span>Nội dung bài học</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-slate-300 fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 border-0 position-relative" 
                                id="resources-tab" data-bs-toggle="tab" data-bs-target="#resources-content" type="button" role="tab" style="background: transparent;">
                            <i class="bi bi-folder-symlink text-warning"></i>
                            <span>Tài liệu & Học liệu</span>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLesson.MaterialUrl))
                            {
                                <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.65rem;">1</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-slate-300 fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 border-0 position-relative" 
                                id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes-content" type="button" role="tab" style="background: transparent;">
                            <i class="bi bi-pencil-square text-success"></i>
                            <span>Ghi chú của tôi</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-slate-300 fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 border-0 position-relative" 
                                id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" style="background: transparent;">
                            <i class="bi bi-chat-dots text-info"></i>
                            <span>Hỏi đáp & Thảo luận</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-slate-300 fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 border-0 position-relative" 
                                id="quiz-tab" data-bs-toggle="tab" data-bs-target="#quiz-content" type="button" role="tab" style="background: transparent;">
                            <i class="bi bi-question-square-fill text-warning"></i>
                            <span>Trắc nghiệm luyện tập</span>
                            @if (Model.CourseQuiz != null && Model.CourseQuiz.QuizQuestions.Any())
                            {
                                <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.65rem;">Luyện tập</span>
                            }
                        </button>
                    </li>
                </ul>

                <!-- Tab Panes -->
                <div class="tab-content" id="learningTabContent">
                    
                    <!-- TAB 1: OVERVIEW & LESSON CONTENT -->
                    <div class="tab-pane fade show active" id="overview-content" role="tabpanel">
                        <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                            <!-- Header Info -->
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <div>
                                    <div class="text-primary small fw-semibold mb-1">
                                        <i class="bi bi-bookmark-fill me-1"></i>@Model.CurrentLesson.SectionName
                                    </div>
                                    <h2 class="fw-bold text-white mb-2">@Model.CurrentLesson.Title</h2>
                                    <div class="d-flex align-items-center gap-3 small text-slate-400" style="color: #94a3b8;">
                                        <span><i class="bi bi-clock me-1 text-primary"></i>Thời lượng: @Model.CurrentLesson.DurationMinutes phút</span>
                                        <span>•</span>
                                        <span><i class="bi bi-sort-numeric-down me-1 text-primary"></i>Thứ tự: Bài số @Model.CurrentLesson.Order</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Lesson Body Text -->
                            <div class="lesson-rich-text text-slate-300" style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.8;">
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentLesson.Content))
                                {
                                    <div style="white-space: pre-wrap;">@Model.CurrentLesson.Content</div>
                                }
                                else
                                {
                                    <p class="text-slate-400 fst-italic">
                                        Nội dung bài giảng đang được biên soạn chi tiết. Hãy theo dõi video hướng dẫn ở trên và tải tài liệu đính kèm ở tab <strong>Tài liệu & Học liệu</strong>.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: RESOURCES & ATTACHMENTS -->
                    <div class="tab-pane fade" id="resources-content" role="tabpanel">
                        <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                            <h4 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-arrow-down-fill text-warning"></i>
                                <span>Tài liệu & Mã nguồn đính kèm</span>
                            </h4>
                            <p class="text-slate-400 mb-4" style="color: #94a3b8;">
                                Tải về mã nguồn mẫu, slide trình chiếu bài giảng và tài liệu thực hành bổ trợ cho bài học này. Đặc biệt, bạn có thể dùng **AI để tự động sinh bài trắc nghiệm luyện tập** trực tiếp từ tài liệu!
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLesson.MaterialUrl))
                            {
                                <div class="p-3 p-md-4 rounded-4 d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4" 
                                     style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm" 
                                             style="width: 50px; height: 50px; background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                                            <i class="bi bi-file-earmark-zip-fill fs-3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-white mb-1">
                                                @(string.IsNullOrWhiteSpace(Model.CurrentLesson.AttachmentName) ? "Tài liệu bài học đính kèm" : Model.CurrentLesson.AttachmentName)
                                            </h6>
                                            <span class="small text-slate-400" style="color: #94a3b8;">Học liệu chính thức từ giảng viên</span>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <a href="@Model.CurrentLesson.MaterialUrl" download class="btn btn-outline-warning rounded-pill px-4 py-2.5 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                                            <i class="bi bi-cloud-arrow-down-fill fs-5"></i>
                                            <span>Tải tài liệu ngay</span>
                                        </a>
                                        <button type="button" class="btn btn-warning rounded-pill px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm text-dark" onclick="startAiQuizFromLesson(@Model.CurrentLesson.Id)">
                                            <i class="bi bi-stars fs-5 text-primary"></i>
                                            <span>AI Tạo Quiz từ Tài liệu</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 mb-4 rounded-4" style="background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(255, 255, 255, 0.1);">
                                    <i class="bi bi-folder-x text-slate-500 fs-1 d-block mb-2" style="color: #64748b;"></i>
                                    <h6 class="text-white fw-bold mb-1">Chưa có file tài liệu đính kèm riêng</h6>
                                    <p class="small text-slate-400 mb-3" style="color: #94a3b8;">Bạn vẫn có thể dùng AI để sinh bài kiểm tra trắc nghiệm từ nội dung bài giảng hiện tại!</p>
                                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm" onclick="startAiQuizFromLesson(@Model.CurrentLesson.Id)">
                                        <i class="bi bi-stars fs-5 text-warning"></i>
                                        <span>AI Tạo Quiz từ Bài giảng này</span>
                                    </button>
                                </div>
                            }

                            <!-- Khu vực: Tải lên tài liệu ngoài để AI sinh Quiz -->
                            <div class="p-4 rounded-4" style="background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.2);">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-robot text-primary fs-5"></i>
                                    <h6 class="fw-bold text-white mb-0">Hoặc dán nội dung tài liệu của bạn để AI tạo câu hỏi:</h6>
                                </div>
                                <p class="small text-slate-400 mb-3">Nếu bạn có file ghi chép, tài liệu tóm tắt hoặc nội dung vừa tải về, hãy dán vào đây để AI phân tích và tạo bài trắc nghiệm ôn tập tức thì.</p>
                                <textarea id="customMaterialText" class="form-control rounded-3 p-3 mb-3 text-white" rows="3" 
                                          placeholder="Dán nội dung tài liệu cần tạo bài trắc nghiệm vào đây..." 
                                          style="background: rgba(0, 0, 0, 0.4); border-color: rgba(255, 255, 255, 0.15); font-size: 0.9rem;"></textarea>
                                <div class="d-flex justify-content-end">
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5" onclick="startAiQuizFromCustomText()">
                                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                                        <span>AI Sinh Quiz từ nội dung trên</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: PERSONAL NOTES (AUTO-SAVE TO LOCALSTORAGE) -->
                    <div class="tab-pane fade" id="notes-content" role="tabpanel">
                        <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-journal-text text-success"></i>
                                    <span>Vở ghi chép cá nhân</span>
                                </h4>
                                <span id="noteSaveStatus" class="small text-success fw-medium" style="display: none;">
                                    <i class="bi bi-check-circle me-1"></i>Đã tự động lưu
                                </span>
                            </div>
                            <p class="text-slate-400 small mb-3" style="color: #94a3b8;">
                                Ghi lại những điểm cốt lõi, đoạn code quan trọng hoặc mốc thời gian video. Ghi chú được lưu trữ an toàn trên trình duyệt của bạn.
                            </p>
                            <textarea id="lessonNotesArea" class="form-control rounded-3 p-3 mb-3 text-white" rows="8" 
                                      placeholder="Viết ghi chú của bạn cho bài học này tại đây (Ví dụ: 03:25 - Clean Architecture Dependency Rule)..." 
                                      style="background: rgba(0, 0, 0, 0.4); border-color: rgba(255, 255, 255, 0.15); font-family: monospace; font-size: 0.95rem;"></textarea>
                            <div class="d-flex justify-content-end">
                                <button id="saveNoteManualBtn" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-save"></i>
                                    <span>Lưu ghi chú</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 4: Q&A / DISCUSSIONS -->
                    <div class="tab-pane fade" id="qa-content" role="tabpanel">
                        <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                            <h4 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-question-circle-fill text-info"></i>
                                <span>Hỏi đáp & Thảo luận cùng Giảng viên</span>
                            </h4>
                            <p class="text-slate-400 mb-4" style="color: #94a3b8;">
                                Bạn gặp khó khăn hoặc có thắc mắc trong quá trình thực hành? Đặt câu hỏi tại đây để được hỗ trợ giải đáp nhanh chóng.
                            </p>

                            <div class="p-4 rounded-4 mb-4 text-center" style="background: rgba(255, 255, 255, 0.03); border: 1px dashed rgba(255, 255, 255, 0.15);">
                                <i class="bi bi-chat-heart-fill text-primary fs-2 mb-2 d-block"></i>
                                <h6 class="text-white fw-bold mb-1">Cộng đồng học viên EduFlyUp</h6>
                                <p class="small text-slate-400 mb-3" style="color: #94a3b8; max-width: 480px; margin: 0 auto;">
                                    Tham gia nhóm Zalo / Discord kín của khóa học để trao đổi trực tiếp mã nguồn và thảo luận bài tập cùng các học viên khác.
                                </p>
                                <a href="https://github.com" target="_blank" class="btn btn-outline-brand rounded-pill btn-sm px-4 py-2">
                                    <i class="bi bi-discord me-1"></i>Tham gia kênh thảo luận
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 5: PRACTICE QUIZ / KNOWLEDGE CHECK -->
                    <div class="tab-pane fade" id="quiz-content" role="tabpanel">
                        <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 shadow-sm" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                            @if (Model.CourseQuiz != null && Model.CourseQuiz.QuizQuestions.Any())
                            {
                                var questionsList = Model.CourseQuiz.QuizQuestions
                                    .OrderBy(qq => qq.Order)
                                    .Select(qq => qq.Question)
                                    .Where(q => q != null)
                                    .ToList();

                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                    <div>
                                        <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1 rounded-pill small mb-2" style="background: rgba(234, 179, 8, 0.15); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3);">
                                            <i class="bi bi-journal-check"></i>
                                            <span>Trắc nghiệm luyện tập kiến thức</span>
                                        </div>
                                        <h3 class="fw-bold text-white mb-1">Luyện Tập Trắc Nghiệm Bài Học</h3>
                                        <div class="d-flex align-items-center gap-3 small text-slate-400" style="color: #94a3b8;">
                                            <span><i class="bi bi-clock me-1 text-primary"></i>Thời gian: Tự do</span>
                                            <span>•</span>
                                            <span><i class="bi bi-question-circle me-1 text-warning"></i>Số lượng: @questionsList.Count câu hỏi</span>
                                            <span>•</span>
                                            <span class="text-info"><i class="bi bi-info-circle me-1"></i>Ôn tập trước khi thi Final Test ở Sidebar</span>
                                        </div>
                                    </div>

                                    @if (Model.CanManageCourse)
                                    {
                                        <a asp-controller="Quiz" asp-action="ManageQuestions" asp-route-id="@Model.CourseQuiz.Id" class="btn btn-outline-secondary rounded-pill btn-sm px-3 py-1.5 text-white" target="_blank">
                                            <i class="bi bi-gear me-1"></i>Quản lý câu hỏi (CMS)
                                        </a>
                                    }
                                </div>

                                <!-- Practice Quiz Score Summary Banner -->
                                <div id="quizResultBanner" class="p-4 rounded-4 mb-4" style="display: none;">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div id="quizResultIconWrapper" class="rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                                <i id="quizResultIcon" class="fs-2"></i>
                                            </div>
                                            <div>
                                                <h5 id="quizResultTitle" class="fw-bold mb-1"></h5>
                                                <p id="quizResultSubtitle" class="mb-0 small"></p>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-3">
                                            <div class="text-end">
                                                <span class="small d-block opacity-75">Điểm luyện tập</span>
                                                <h3 id="quizScoreText" class="fw-extrabold mb-0"></h3>
                                            </div>
                                            <button id="retryQuizBtn" class="btn btn-light rounded-pill px-4 py-2 fw-semibold btn-sm shadow-sm">
                                                <i class="bi bi-arrow-repeat me-1"></i>Làm lại câu hỏi
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Questions Form -->
                                <form id="quizForm">
                                    <div class="d-flex flex-column gap-4 mb-4">
                                        @for (int i = 0; i < questionsList.Count; i++)
                                        {
                                            var q = questionsList[i];
                                            var qNum = i + 1;
                                            var options = q.Options.ToList();

                                            <div class="p-4 rounded-4 question-block" id="question_block_@q.Id" 
                                                 style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);"
                                                 data-question-id="@q.Id">
                                                
                                                <div class="d-flex align-items-start gap-2.5 mb-3">
                                                    <span class="badge rounded-circle p-2 flex-shrink-0" style="width: 32px; height: 32px; background: rgba(99, 102, 241, 0.2); color: #818cf8; font-size: 0.85rem;">
                                                        @qNum
                                                    </span>
                                                    <div>
                                                        <h6 class="fw-bold text-white mb-1" style="line-height: 1.5;">@q.Content</h6>
                                                        <span class="small text-slate-400" style="color: #94a3b8; font-size: 0.75rem;">(Chọn 1 đáp án đúng nhất)</span>
                                                    </div>
                                                </div>

                                                <!-- Options List -->
                                                <div class="d-flex flex-column gap-2 ms-md-4">
                                                    @foreach (var opt in options)
                                                    {
                                                        var optRadioId = $"opt_{q.Id}_{opt.Id}";
                                                        <label class="p-3 rounded-3 d-flex align-items-center gap-3 option-label" for="@optRadioId" 
                                                               style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); cursor: pointer; transition: all 0.2s ease;">
                                                            <input class="form-check-input flex-shrink-0 shadow-none mt-0" type="radio" 
                                                                   name="q_@q.Id" id="@optRadioId" value="@opt.Id" 
                                                                   data-is-correct="@(opt.IsCorrect ? "true" : "false")" />
                                                            <span class="text-slate-200 small fw-medium" style="color: #e2e8f0;">@opt.Text</span>
                                                        </label>
                                                    }
                                                </div>

                                                <!-- Explanation Box (Hidden until submit) -->
                                                <div class="explanation-box mt-3 p-3 rounded-3" style="display: none; background: rgba(99, 102, 241, 0.1); border-left: 4px solid #6366f1;">
                                                    <div class="small fw-bold text-indigo-300 mb-1" style="color: #a5b4fc;">
                                                        <i class="bi bi-lightbulb-fill me-1"></i>Giải thích chi tiết:
                                                    </div>
                                                    <p class="small text-slate-300 mb-0" style="color: #cbd5e1;">@q.Explanation</p>
                                                </div>

                                            </div>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-end pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                        <button type="button" id="submitQuizBtn" class="btn btn-brand rounded-pill px-5 py-3 fw-bold d-inline-flex align-items-center gap-2 shadow-glow">
                                            <i class="bi bi-check2-circle fs-5"></i>
                                            <span>Nộp bài kiểm tra & Chấm điểm</span>
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-patch-question text-slate-500 fs-1 d-block mb-3" style="color: #64748b;"></i>
                                    <h5 class="text-white fw-bold mb-1">Khóa học chưa có bài kiểm tra trắc nghiệm</h5>
                                    <p class="small text-slate-400 mb-0" style="color: #94a3b8;">Giảng viên đang biên soạn bộ câu hỏi trắc nghiệm cho khóa học này. Vui lòng quay lại sau!</p>
                                </div>
                            }
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Right Curriculum Sidebar (Coursera Accordion Style) -->
        <aside id="learningSidebar" class="curriculum-sidebar flex-shrink-0 border-start overflow-y-auto" 
               style="width: 360px; background: #111827; border-color: rgba(255, 255, 255, 0.08) !important; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
            
            <!-- Sidebar Header -->
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between position-sticky top-0" 
                 style="background: #111827; border-color: rgba(255, 255, 255, 0.08) !important; z-index: 10;">
                <div>
                    <h6 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-collection-play-fill text-primary"></i>
                        <span>Nội dung khóa học</span>
                    </h6>
                    <span class="small text-slate-400" style="color: #94a3b8; font-size: 0.78rem;">
                        @Model.TotalLessonsCount bài học • @Model.TotalCourseDurationMinutes phút
                    </span>
                </div>
                <button id="closeSidebarMobileBtn" class="btn btn-sm btn-dark rounded-circle d-md-none text-slate-400">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- PINNED FINAL TEST CARD AT TOP OF SIDEBAR -->
            <div class="p-3 border-bottom position-relative" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(99, 102, 241, 0.12) 100%); border-color: rgba(255, 255, 255, 0.08) !important;">
                <div class="card border-0 rounded-4 p-3 position-relative overflow-hidden shadow-sm" 
                     style="background: #1e1b4b; border: 1px solid rgba(234, 179, 8, 0.35) !important;">
                    
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1" 
                              style="background: rgba(234, 179, 8, 0.2); color: #facc15; font-size: 0.72rem; border: 1px solid rgba(234, 179, 8, 0.4);">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>BÀI THI TỐT NGHIỆP</span>
                        </span>
                        <span id="finalTestLockBadge" class="badge bg-secondary rounded-pill small" style="font-size: 0.68rem;">
                            <i class="bi bi-lock-fill me-1"></i>Đang khóa
                        </span>
                    </div>

                    <h6 class="fw-bold text-white mb-1 d-flex align-items-center gap-1.5" style="font-size: 0.92rem;">
                        <i class="bi bi-patch-check-fill text-warning"></i>
                        <span>Đề Thi Tốt Nghiệp (Final Test)</span>
                    </h6>
                    
                    <p class="small text-slate-300 mb-2.5" id="finalTestConditionText" style="color: #cbd5e1; font-size: 0.75rem; line-height: 1.45;">
                        Điều kiện cấp Chứng chỉ: Hoàn thành &ge; 95% bài học (<strong id="finalProgressStatusText" class="text-warning">0%</strong>) & Đạt &ge; 95 điểm bài thi.
                    </p>

                    <!-- Final Test Action Button -->
                    <div id="finalTestActionWrapper">
                        <button type="button" id="btnOpenFinalTest" class="btn btn-outline-secondary w-100 rounded-pill btn-sm fw-bold disabled" 
                                data-bs-toggle="modal" data-bs-target="#finalTestModal" style="font-size: 0.82rem; pointer-events: none; opacity: 0.65;">
                            <i class="bi bi-lock-fill me-1"></i>
                            <span id="finalBtnLabel">Chưa đủ điều kiện dự thi</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Curriculum Accordion List -->
            <div class="accordion accordion-flush" id="curriculumAccordion">
                @for (int sIdx = 0; sIdx < Model.Sections.Count; sIdx++)
                {
                    var sec = Model.Sections[sIdx];
                    var hasCurrentLesson = sec.Lessons.Any(l => l.Id == Model.CurrentLesson.Id);
                    var collapseId = $"collapseSection_{sIdx}";

                    <div class="accordion-item border-bottom" style="background: transparent; border-color: rgba(255, 255, 255, 0.06) !important;">
                        
                        <!-- Section Header -->
                        <h2 class="accordion-header" id="heading_@sIdx">
                            <button class="accordion-button @(hasCurrentLesson ? "" : "collapsed") px-3 py-3 text-white fw-bold shadow-none" 
                                    type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" 
                                    aria-expanded="@(hasCurrentLesson ? "true" : "false")"
                                    style="background: rgba(255, 255, 255, 0.02); font-size: 0.88rem;">
                                <div class="d-flex flex-column text-start me-2">
                                    <span class="text-truncate">@sec.SectionName</span>
                                    <span class="small fw-normal text-slate-400" style="color: #94a3b8; font-size: 0.75rem;">
                                        @sec.Lessons.Count bài học • @sec.TotalDurationMinutes phút
                                    </span>
                                </div>
                            </button>
                        </h2>

                        <!-- Section Lessons -->
                        <div id="@collapseId" class="accordion-collapse collapse @(hasCurrentLesson ? "show" : "")" 
                             data-bs-parent="#curriculumAccordion">
                            <div class="accordion-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var item in sec.Lessons)
                                    {
                                        var isPlaying = (item.Id == Model.CurrentLesson.Id);
                                        <a asp-action="Learn" asp-route-id="@item.Id" 
                                           class="list-group-item list-group-item-action px-3 py-2.5 d-flex align-items-start gap-2.5 border-0 lesson-item-row @(isPlaying ? "active-lesson" : "")" 
                                           style="background: @(isPlaying ? "rgba(99, 102, 241, 0.15)" : "transparent"); border-left: 3px solid @(isPlaying ? "#6366f1" : "transparent") !important; text-decoration: none;">
                                            
                                            <!-- Checkmark / Play indicator -->
                                            <div class="lesson-status-icon pt-0.5 flex-shrink-0" data-lesson-id="@item.Id">
                                                @if (isPlaying)
                                                {
                                                    <i class="bi bi-play-circle-fill text-primary fs-6"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-circle text-slate-500 fs-6 status-circle" style="color: #64748b;"></i>
                                                }
                                            </div>

                                            <!-- Lesson Info -->
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="d-flex align-items-center justify-content-between gap-1 mb-0.5">
                                                    <span class="small fw-semibold text-truncate @(isPlaying ? "text-primary" : "text-slate-200")" 
                                                          style="font-size: 0.84rem; color: @(isPlaying ? "#818cf8 !important" : "#e2e8f0");" 
                                                          title="@item.Title">
                                                        @item.Order. @item.Title
                                                    </span>
                                                </div>

                                                <div class="d-flex align-items-center gap-2 small text-slate-400" style="color: #94a3b8; font-size: 0.72rem;">
                                                    <span><i class="bi bi-clock me-1"></i>@item.DurationMinutes phút</span>
                                                    @if (item.IsPreview)
                                                    {
                                                        <span class="badge rounded-pill text-info px-2 py-0.5" style="background: rgba(14, 165, 233, 0.15); font-size: 0.65rem;">
                                                            Học thử
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.MaterialUrl))
                                                    {
                                                        <span title="Có tài liệu đính kèm"><i class="bi bi-paperclip text-warning"></i></span>
                                                    }
                                                </div>
                                            </div>

                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                }
            </div>

        </aside>

    </div>

</div>

<!-- ================= MODAL BÀI THI TỐT NGHIỆP (FINAL TEST) ================= -->
<div class="modal fade" id="finalTestModal" tabindex="-1" aria-labelledby="finalTestModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg" style="background: #0f172a; color: #f8fafc; border: 1px solid rgba(234, 179, 8, 0.3) !important;">
            
            <!-- Modal Header -->
            <div class="modal-header border-bottom p-4" style="background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%); border-color: rgba(255, 255, 255, 0.1) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" 
                         style="width: 52px; height: 52px; background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%); color: #0f172a;">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="d-inline-flex align-items-center gap-2 px-2.5 py-0.5 rounded-pill mb-1" 
                             style="background: rgba(234, 179, 8, 0.15); color: #facc15; font-size: 0.75rem; border: 1px solid rgba(234, 179, 8, 0.3);">
                            <i class="bi bi-award-fill"></i>
                            <span>KỲ THI TỐT NGHIỆP CHÍNH THỨC</span>
                        </div>
                        <h4 class="modal-title fw-bold text-white mb-0" id="finalTestModalLabel">
                            Bài Thi Tốt Nghiệp (Final Test) - @Model.Course.Title
                        </h4>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 p-md-5">
                
                <!-- STATE 1: BỊ KHÓA KHI CHƯA HOÀN THÀNH >= 95% BÀI HỌC -->
                <div id="finalTestLockedState" class="text-center py-5">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow" 
                         style="width: 90px; height: 90px; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 2px solid rgba(239, 68, 68, 0.3);">
                        <i class="bi bi-lock-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-2">Bài Thi Tốt Nghiệp Đang Bị Khóa</h3>
                    <p class="text-slate-300 mx-auto mb-4" style="max-width: 600px; color: #cbd5e1; font-size: 1.05rem; line-height: 1.6;">
                        Để đảm bảo chuẩn chất lượng đào tạo, bạn cần <strong>học và bấm "Đánh dấu đã hoàn thành" tối thiểu 95% số bài học</strong> của khóa học trước khi được phép dự thi tốt nghiệp.
                    </p>
                    
                    <div class="p-3.5 rounded-4 mx-auto mb-4" style="max-width: 450px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-slate-400" style="color: #94a3b8;">Tiến độ bài học hiện tại:</span>
                            <strong id="modalLockProgressText" class="text-warning">0%</strong>
                        </div>
                        <div class="progress" style="height: 10px; background: rgba(255, 255, 255, 0.1);">
                            <div id="modalLockProgressBar" class="progress-bar bg-warning" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <div class="small mt-2 text-slate-400" style="color: #94a3b8; font-size: 0.8rem;">
                            Cần đạt: <span class="text-success fw-bold">&ge; 95%</span> để mở khóa bài thi
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold" data-bs-dismiss="modal">
                        <i class="bi bi-play-circle me-1"></i>Tiếp tục học để hoàn thành bài giảng
                    </button>
                </div>

                <!-- STATE 2: ĐÃ ĐỦ ĐIỀU KIỆN DỰ THI FINAL TEST -->
                <div id="finalTestUnlockedState" style="display: none;">
                    
                    @if (Model.CourseQuiz != null && Model.CourseQuiz.QuizQuestions.Any())
                    {
                        var finalQuestions = Model.CourseQuiz.QuizQuestions
                            .OrderBy(qq => qq.Order)
                            .Select(qq => qq.Question)
                            .Where(q => q != null)
                            .ToList();

                        <!-- Final Test Banner & Conditions -->
                        <div class="alert border-0 rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, rgba(234, 179, 8, 0.15) 0%, rgba(99, 102, 241, 0.2) 100%); border-left: 5px solid #eab308 !important;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-patch-check-fill fs-2 text-warning"></i>
                                <div>
                                    <h5 class="fw-bold text-white mb-1">Bạn Đã Đủ Điều Kiện Dự Thi Tốt Nghiệp!</h5>
                                    <p class="mb-0 small text-slate-200" style="color: #e2e8f0;">
                                        Quy chế tốt nghiệp EduFlyUp: Làm bài thi trắc nghiệm tổng hợp và đạt <strong>từ 95 điểm trở lên (95%)</strong> để được công nhận hoàn thành khóa học và cấp Chứng chỉ tốt nghiệp chuẩn quốc tế.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Final Test Result Banner -->
                        <div id="finalTestResultBanner" class="p-4 rounded-4 mb-4 shadow" style="display: none;">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div id="finalResultIconWrapper" class="rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 60px; height: 60px;">
                                        <i id="finalResultIcon" class="fs-2"></i>
                                    </div>
                                    <div>
                                        <h5 id="finalResultTitle" class="fw-bold mb-1"></h5>
                                        <p id="finalResultSubtitle" class="mb-0 small"></p>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="text-end">
                                        <span class="small d-block opacity-75">Điểm số Final Test</span>
                                        <h2 id="finalScoreText" class="fw-extrabold mb-0"></h2>
                                    </div>
                                    <div id="finalCertActions" class="d-none d-flex flex-wrap gap-2">
                                        <a id="btnViewFinalCert" href="#" target="_blank" class="btn btn-warning rounded-pill px-4 py-2.5 fw-bold shadow text-dark d-inline-flex align-items-center gap-2 animate__animated animate__pulse animate__infinite">
                                            <i class="bi bi-award-fill"></i>
                                            <span>XEM CHỨNG CHỈ CỦA BẠN</span>
                                        </a>
                                        <a asp-controller="Courses" asp-action="MyCourses" class="btn btn-outline-light rounded-pill px-3 py-2.5 fw-semibold small">
                                            <span>Mục Chứng chỉ của tôi</span>
                                        </a>
                                    </div>
                                    <button type="button" id="retryFinalTestBtn" class="btn btn-light rounded-pill px-4 py-2.5 fw-semibold btn-sm shadow-sm">
                                        <i class="bi bi-arrow-repeat me-1"></i>Làm lại bài thi
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Final Questions Form -->
                        <form id="finalTestForm">
                            <div class="d-flex flex-column gap-4 mb-4">
                                @for (int i = 0; i < finalQuestions.Count; i++)
                                {
                                    var q = finalQuestions[i];
                                    var qIndex = i + 1;
                                    var options = q.Options.OrderBy(o => o.Id).ToList();

                                    <div class="final-question-block p-4 rounded-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);" data-question-id="@q.Id">
                                        <div class="d-flex align-items-start gap-3 mb-3">
                                            <span class="badge rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                                                  style="width: 32px; height: 32px; background: #6366f1; color: #ffffff; font-size: 0.9rem;">
                                                @qIndex
                                            </span>
                                            <div class="flex-grow-1">
                                                <h5 class="fw-bold text-white mb-0" style="line-height: 1.5;">@q.Content</h5>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-column gap-2 ms-md-4 ps-md-2">
                                            @foreach (var opt in options)
                                            {
                                                var optText = opt.Text;
                                                <label class="final-option-label p-3 rounded-3 d-flex align-items-center gap-3 cursor-pointer transition-all" 
                                                       style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); cursor: pointer;">
                                                    <input type="radio" name="final_question_@q.Id" value="@opt.Id" 
                                                           data-is-correct="@opt.IsCorrect.ToString().ToLower()" 
                                                           class="form-check-input flex-shrink-0 m-0" style="width: 1.25rem; height: 1.25rem;" />
                                                    <span class="text-slate-200" style="color: #e2e8f0;">@optText</span>
                                                </label>
                                            }
                                        </div>

                                        <div class="final-explanation-box mt-3 ms-md-4 ps-md-2 p-3 rounded-3" style="display: none; background: rgba(99, 102, 241, 0.1); border-left: 3px solid #6366f1;">
                                            <span class="small fw-bold text-primary d-block mb-1">
                                                <i class="bi bi-lightbulb-fill me-1"></i>Giải thích đáp án:
                                            </span>
                                            <p class="small text-slate-300 mb-0" style="color: #cbd5e1;">@(string.IsNullOrWhiteSpace(q.Explanation) ? "Đáp án chính xác đã được hệ thống ghi nhận." : q.Explanation)</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-end pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <button type="button" id="submitFinalTestBtn" class="btn btn-warning rounded-pill px-5 py-3 fw-bold text-dark d-inline-flex align-items-center gap-2 shadow-lg">
                                    <i class="bi bi-mortarboard-fill fs-5"></i>
                                    <span>Nộp bài thi tốt nghiệp & Chấm điểm</span>
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-exclamation-circle text-warning fs-1 d-block mb-3"></i>
                            <h5 class="text-white fw-bold mb-1">Khóa học chưa thiết lập đề thi tốt nghiệp</h5>
                            <p class="small text-slate-400 mb-0" style="color: #94a3b8;">Hội đồng khảo thí đang cập nhật đề thi tốt nghiệp cho khóa học này.</p>
                        </div>
                    }

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const courseId = @Model.Course.Id;
            const currentLessonId = @Model.CurrentLesson.Id;
            const totalLessons = @Model.TotalLessonsCount;

            // 1. Quản lý trạng thái hoàn thành bài học qua localStorage
            const storageKey = `edu_completed_lessons_course_${courseId}`;
            let completedLessons = JSON.parse(localStorage.getItem(storageKey) || "[]");

            const markBtn = document.getElementById("markCompletedBtn");
            const completeIcon = document.getElementById("completeIcon");
            const completeText = document.getElementById("completeText");

            function updateCompletionUI() {
                const isCompleted = completedLessons.includes(currentLessonId);
                if (isCompleted) {
                    markBtn.classList.remove("btn-outline-success");
                    markBtn.classList.add("btn-success");
                    completeIcon.className = "bi bi-check2-all fs-5";
                    completeText.textContent = "Đã hoàn thành bài học này";
                } else {
                    markBtn.classList.add("btn-outline-success");
                    markBtn.classList.remove("btn-success");
                    completeIcon.className = "bi bi-check2-circle fs-5";
                    completeText.textContent = "Đánh dấu đã hoàn thành";
                }

                // Cập nhật các icon trong sidebar
                document.querySelectorAll(".lesson-status-icon").forEach(el => {
                    const lId = parseInt(el.getAttribute("data-lesson-id"));
                    if (lId !== currentLessonId) {
                        if (completedLessons.includes(lId)) {
                            el.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-6"></i>';
                        } else {
                            el.innerHTML = '<i class="bi bi-circle text-slate-500 fs-6" style="color: #64748b;"></i>';
                        }
                    }
                });

                // Cập nhật thanh % tiến độ toàn khóa
                const progressPct = totalLessons > 0 ? Math.round((completedLessons.length / totalLessons) * 100) : 0;
                const progressBar = document.getElementById("courseProgressBar");
                const progressText = document.getElementById("courseProgressText");
                if (progressBar) progressBar.style.width = `${progressPct}%`;
                if (progressText) progressText.textContent = `${progressPct}% (${completedLessons.length}/${totalLessons} bài)`;

                // Cập nhật trạng thái Final Test trên Sidebar & trong Modal
                const certStorageKey = `edu_cert_issued_${courseId}`;
                const savedCertUrl = localStorage.getItem(certStorageKey);

                const finalLockBadge = document.getElementById("finalTestLockBadge");
                const finalProgressStatusText = document.getElementById("finalProgressStatusText");
                const finalBtn = document.getElementById("btnOpenFinalTest");
                const finalBtnLabel = document.getElementById("finalBtnLabel");
                const finalConditionText = document.getElementById("finalTestConditionText");

                const modalLockedState = document.getElementById("finalTestLockedState");
                const modalUnlockedState = document.getElementById("finalTestUnlockedState");
                const modalLockProgressText = document.getElementById("modalLockProgressText");
                const modalLockProgressBar = document.getElementById("modalLockProgressBar");

                if (finalProgressStatusText) finalProgressStatusText.textContent = `${progressPct}%`;
                if (modalLockProgressText) modalLockProgressText.textContent = `${progressPct}% (${completedLessons.length}/${totalLessons} bài)`;
                if (modalLockProgressBar) modalLockProgressBar.style.width = `${progressPct}%`;

                const isEligible = (progressPct >= 95);

                if (savedCertUrl) {
                    // Đã thi đỗ và có chứng chỉ
                    if (finalLockBadge) {
                        finalLockBadge.className = "badge bg-warning text-dark rounded-pill";
                        finalLockBadge.innerHTML = '<i class="bi bi-award-fill me-1"></i>ĐÃ CẤP CHỨNG CHỈ';
                    }
                    if (finalBtn) {
                        finalBtn.className = "btn btn-warning w-100 rounded-pill btn-sm fw-bold text-dark shadow-sm";
                        finalBtn.style.pointerEvents = "auto";
                        finalBtn.style.opacity = "1";
                        finalBtn.removeAttribute("disabled");
                        finalBtn.onclick = function () { window.open(savedCertUrl, "_blank"); };
                    }
                    if (finalBtnLabel) finalBtnLabel.textContent = "XEM CHỨNG CHỈ TỐT NGHIỆP";
                    if (finalConditionText) finalConditionText.innerHTML = '<span class="text-warning fw-semibold"><i class="bi bi-patch-check-fill me-1"></i>Chúc mừng bạn đã hoàn thành xuất sắc khóa học!</span>';

                    if (modalLockedState) modalLockedState.style.display = "none";
                    if (modalUnlockedState) modalUnlockedState.style.display = "block";

                } else if (isEligible) {
                    // Đã học >= 95% bài học -> Mở khóa bài thi
                    if (finalLockBadge) {
                        finalLockBadge.className = "badge bg-success rounded-pill animate__animated animate__pulse animate__infinite";
                        finalLockBadge.innerHTML = '<i class="bi bi-unlock-fill me-1"></i>SẴN SÀNG THI';
                    }
                    if (finalBtn) {
                        finalBtn.className = "btn btn-warning w-100 rounded-pill btn-sm fw-bold text-dark shadow animate__animated animate__heartBeat";
                        finalBtn.style.pointerEvents = "auto";
                        finalBtn.style.opacity = "1";
                        finalBtn.removeAttribute("disabled");
                        finalBtn.setAttribute("data-bs-toggle", "modal");
                        finalBtn.setAttribute("data-bs-target", "#finalTestModal");
                        finalBtn.onclick = null;
                    }
                    if (finalBtnLabel) finalBtnLabel.textContent = "LÀM BÀI FINAL TEST NGAY";
                    if (finalConditionText) finalConditionText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Đủ điều kiện dự thi!</span> Hãy làm bài test đạt &ge; 95 điểm để nhận Chứng chỉ.';

                    if (modalLockedState) modalLockedState.style.display = "none";
                    if (modalUnlockedState) modalUnlockedState.style.display = "block";

                } else {
                    // Chưa đủ điều kiện -> Khóa bài thi
                    if (finalLockBadge) {
                        finalLockBadge.className = "badge bg-secondary rounded-pill small";
                        finalLockBadge.innerHTML = '<i class="bi bi-lock-fill me-1"></i>Đang khóa';
                    }
                    if (finalBtn) {
                        finalBtn.className = "btn btn-outline-secondary w-100 rounded-pill btn-sm fw-bold disabled";
                        finalBtn.style.pointerEvents = "none";
                        finalBtn.style.opacity = "0.65";
                        finalBtn.setAttribute("disabled", "true");
                        finalBtn.onclick = null;
                    }
                    if (finalBtnLabel) finalBtnLabel.textContent = "Chưa đủ điều kiện dự thi";
                    if (finalConditionText) finalConditionText.innerHTML = `Điều kiện cấp Chứng chỉ: Hoàn thành &ge; 95% bài học (<strong class="text-warning">${progressPct}%</strong>) & Đạt &ge; 95 điểm bài thi.`;

                    if (modalLockedState) modalLockedState.style.display = "block";
                    if (modalUnlockedState) modalUnlockedState.style.display = "none";
                }
            }

            markBtn.addEventListener("click", function () {
                const idx = completedLessons.indexOf(currentLessonId);
                if (idx > -1) {
                    completedLessons.splice(idx, 1);
                } else {
                    completedLessons.push(currentLessonId);
                }
                localStorage.setItem(storageKey, JSON.stringify(completedLessons));
                updateCompletionUI();
            });

            updateCompletionUI();

            // 2. Tự động lưu ghi chú bài học (Auto-save Notes)
            const notesKey = `edu_note_lesson_${currentLessonId}`;
            const notesArea = document.getElementById("lessonNotesArea");
            const noteStatus = document.getElementById("noteSaveStatus");
            const manualSaveBtn = document.getElementById("saveNoteManualBtn");

            if (notesArea) {
                notesArea.value = localStorage.getItem(notesKey) || "";

                let timeoutId = null;
                notesArea.addEventListener("input", function () {
                    if (noteStatus) noteStatus.style.display = "none";
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        localStorage.setItem(notesKey, notesArea.value);
                        if (noteStatus) {
                            noteStatus.style.display = "inline-flex";
                            setTimeout(() => { noteStatus.style.display = "none"; }, 3000);
                        }
                    }, 800);
                });

                if (manualSaveBtn) {
                    manualSaveBtn.addEventListener("click", function () {
                        localStorage.setItem(notesKey, notesArea.value);
                        if (noteStatus) {
                            noteStatus.style.display = "inline-flex";
                            setTimeout(() => { noteStatus.style.display = "none"; }, 3000);
                        }
                    });
                }
            }

            // 3. Đóng / Mở Sidebar học tập (Theater / Focus Mode)
            const toggleBtn = document.getElementById("toggleCurriculumBtn");
            const sidebar = document.getElementById("learningSidebar");
            const btnText = document.getElementById("curriculumBtnText");
            const closeMobileBtn = document.getElementById("closeSidebarMobileBtn");

            let isSidebarOpen = true;

            function toggleSidebar() {
                isSidebarOpen = !isSidebarOpen;
                if (isSidebarOpen) {
                    sidebar.style.display = "block";
                    sidebar.style.width = "360px";
                    if (btnText) btnText.textContent = "Ẩn bài giảng";
                } else {
                    sidebar.style.width = "0px";
                    setTimeout(() => { if (!isSidebarOpen) sidebar.style.display = "none"; }, 300);
                    if (btnText) btnText.textContent = "Hiện bài giảng";
                }
            }

            if (toggleBtn) toggleBtn.addEventListener("click", toggleSidebar);
            if (closeMobileBtn) closeMobileBtn.addEventListener("click", toggleSidebar);

            // 4. Xử lý Trắc nghiệm Luyện tập Bài học (Practice Quiz trong Tab 5)
            const submitQuizBtn = document.getElementById("submitQuizBtn");
            const quizForm = document.getElementById("quizForm");
            const resultBanner = document.getElementById("quizResultBanner");
            const retryQuizBtn = document.getElementById("retryQuizBtn");

            if (submitQuizBtn && quizForm) {
                submitQuizBtn.addEventListener("click", function () {
                    const questionBlocks = document.querySelectorAll(".question-block");
                    let totalQuestions = questionBlocks.length;
                    let correctCount = 0;

                    questionBlocks.forEach(block => {
                        const checkedRadio = block.querySelector("input[type='radio']:checked");
                        const allLabels = block.querySelectorAll(".option-label");
                        const explanationBox = block.querySelector(".explanation-box");

                        allLabels.forEach(lbl => {
                            lbl.style.background = "rgba(255, 255, 255, 0.02)";
                            lbl.style.borderColor = "rgba(255, 255, 255, 0.08)";
                        });

                        if (checkedRadio) {
                            const isCorrect = checkedRadio.getAttribute("data-is-correct") === "true";
                            const chosenLabel = checkedRadio.closest(".option-label");

                            if (isCorrect) {
                                correctCount++;
                                if (chosenLabel) {
                                    chosenLabel.style.background = "rgba(16, 185, 129, 0.2)";
                                    chosenLabel.style.borderColor = "#10b981";
                                }
                            } else {
                                if (chosenLabel) {
                                    chosenLabel.style.background = "rgba(239, 68, 68, 0.2)";
                                    chosenLabel.style.borderColor = "#ef4444";
                                }
                                const correctRadio = block.querySelector("input[data-is-correct='true']");
                                if (correctRadio) {
                                    const correctLabel = correctRadio.closest(".option-label");
                                    if (correctLabel) {
                                        correctLabel.style.background = "rgba(16, 185, 129, 0.2)";
                                        correctLabel.style.borderColor = "#10b981";
                                    }
                                }
                            }
                        } else {
                            const correctRadio = block.querySelector("input[data-is-correct='true']");
                            if (correctRadio) {
                                const correctLabel = correctRadio.closest(".option-label");
                                if (correctLabel) {
                                    correctLabel.style.background = "rgba(16, 185, 129, 0.15)";
                                    correctLabel.style.borderColor = "#10b981";
                                }
                            }
                        }

                        if (explanationBox) explanationBox.style.display = "block";
                    });

                    const scorePct = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;

                    if (resultBanner) {
                        resultBanner.style.display = "block";
                        const iconWrapper = document.getElementById("quizResultIconWrapper");
                        const icon = document.getElementById("quizResultIcon");
                        const title = document.getElementById("quizResultTitle");
                        const subtitle = document.getElementById("quizResultSubtitle");
                        const scoreText = document.getElementById("quizScoreText");

                        scoreText.textContent = `${correctCount}/${totalQuestions} câu (${scorePct}%)`;

                        resultBanner.style.background = "linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(79, 70, 229, 0.3) 100%)";
                        resultBanner.style.border = "1px solid #6366f1";
                        iconWrapper.style.background = "#6366f1";
                        iconWrapper.style.color = "#ffffff";
                        icon.className = "bi bi-journal-check";
                        title.className = "fw-bold mb-1 text-primary";
                        title.textContent = "KẾT QUẢ ÔN TẬP BÀI HỌC";
                        subtitle.className = "mb-0 small text-slate-300";
                        subtitle.innerHTML = `Bạn đã hoàn thành bài tập rèn luyện với ${correctCount}/${totalQuestions} câu chính xác. <em>Lưu ý: Để nhận Chứng chỉ tốt nghiệp, hãy hoàn thành &ge; 95% bài học và bấm nút 'Làm bài Final Test' ở góc trên Sidebar bên phải.</em>`;

                        resultBanner.scrollIntoView({ behavior: "smooth", block: "nearest" });
                    }
                });

                if (retryQuizBtn) {
                    retryQuizBtn.addEventListener("click", function () {
                        quizForm.reset();
                        document.querySelectorAll(".option-label").forEach(lbl => {
                            lbl.style.background = "rgba(255, 255, 255, 0.02)";
                            lbl.style.borderColor = "rgba(255, 255, 255, 0.08)";
                        });
                        document.querySelectorAll(".explanation-box").forEach(box => {
                            box.style.display = "none";
                        });
                        if (resultBanner) resultBanner.style.display = "none";
                    });
                }
            }

            // 5. Xử lý BÀI THI TỐT NGHIỆP FINAL TEST TRONG MODAL (GÓC TRÊN SIDEBAR)
            const submitFinalBtn = document.getElementById("submitFinalTestBtn");
            const finalForm = document.getElementById("finalTestForm");
            const finalBanner = document.getElementById("finalTestResultBanner");
            const retryFinalBtn = document.getElementById("retryFinalTestBtn");
            const certStorageKey = `edu_cert_issued_${courseId}`;

            if (submitFinalBtn && finalForm) {
                const passingScore = 95;

                submitFinalBtn.addEventListener("click", function () {
                    // Kiểm tra lại tiến độ bài học trước khi chấm
                    const currentProgressPct = totalLessons > 0 ? Math.round((completedLessons.length / totalLessons) * 100) : 0;
                    if (currentProgressPct < 95) {
                        alert(`Bạn mới hoàn thành ${currentProgressPct}% số bài học. Cần đạt tối thiểu 95% bài học mới đủ điều kiện xét tốt nghiệp.`);
                        return;
                    }

                    const blocks = document.querySelectorAll(".final-question-block");
                    let totalQ = blocks.length;
                    let correctCount = 0;

                    blocks.forEach(block => {
                        const checkedRadio = block.querySelector("input[type='radio']:checked");
                        const allLabels = block.querySelectorAll(".final-option-label");
                        const explanationBox = block.querySelector(".final-explanation-box");

                        allLabels.forEach(lbl => {
                            lbl.style.background = "rgba(255, 255, 255, 0.02)";
                            lbl.style.borderColor = "rgba(255, 255, 255, 0.08)";
                        });

                        if (checkedRadio) {
                            const isCorrect = checkedRadio.getAttribute("data-is-correct") === "true";
                            const chosenLabel = checkedRadio.closest(".final-option-label");

                            if (isCorrect) {
                                correctCount++;
                                if (chosenLabel) {
                                    chosenLabel.style.background = "rgba(16, 185, 129, 0.25)";
                                    chosenLabel.style.borderColor = "#10b981";
                                }
                            } else {
                                if (chosenLabel) {
                                    chosenLabel.style.background = "rgba(239, 68, 68, 0.25)";
                                    chosenLabel.style.borderColor = "#ef4444";
                                }
                                const correctRadio = block.querySelector("input[data-is-correct='true']");
                                if (correctRadio) {
                                    const correctLabel = correctRadio.closest(".final-option-label");
                                    if (correctLabel) {
                                        correctLabel.style.background = "rgba(16, 185, 129, 0.25)";
                                        correctLabel.style.borderColor = "#10b981";
                                    }
                                }
                            }
                        } else {
                            const correctRadio = block.querySelector("input[data-is-correct='true']");
                            if (correctRadio) {
                                const correctLabel = correctRadio.closest(".final-option-label");
                                if (correctLabel) {
                                    correctLabel.style.background = "rgba(16, 185, 129, 0.15)";
                                    correctLabel.style.borderColor = "#10b981";
                                }
                            }
                        }

                        if (explanationBox) explanationBox.style.display = "block";
                    });

                    const scorePct = totalQ > 0 ? Math.round((correctCount / totalQ) * 100) : 0;
                    const isPassed = (scorePct >= passingScore);

                    if (finalBanner) {
                        finalBanner.style.display = "block";
                        const iconWrapper = document.getElementById("finalResultIconWrapper");
                        const icon = document.getElementById("finalResultIcon");
                        const title = document.getElementById("finalResultTitle");
                        const subtitle = document.getElementById("finalResultSubtitle");
                        const scoreText = document.getElementById("finalScoreText");
                        const certActions = document.getElementById("finalCertActions");
                        const viewCertBtn = document.getElementById("btnViewFinalCert");

                        scoreText.textContent = `${correctCount}/${totalQ} câu (${scorePct}%)`;

                        if (isPassed) {
                            finalBanner.style.background = "linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(5, 150, 105, 0.4) 100%)";
                            finalBanner.style.border = "1px solid #10b981";
                            iconWrapper.style.background = "#10b981";
                            iconWrapper.style.color = "#ffffff";
                            icon.className = "bi bi-award-fill";
                            title.className = "fw-bold mb-1 text-success";
                            title.textContent = "CHÚC MỪNG! BẠN ĐÃ TỐT NGHIỆP XUẤT SẮC";
                            subtitle.className = "mb-0 small text-slate-200";
                            subtitle.textContent = `Bạn đã hoàn thành xuất sắc ${scorePct}% bài thi (chuẩn >= ${passingScore}%) và 100% bài học. Chứng chỉ tốt nghiệp EduFlyUp đã được cấp và lưu vào mục 'Chứng chỉ của tôi'!`;

                            // Gọi API cấp chứng chỉ
                            fetch('/Certificate/CompleteFinalTest', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    courseId: courseId,
                                    score: scorePct
                                })
                            })
                            .then(r => r.json())
                            .then(res => {
                                if (res && res.success) {
                                    localStorage.setItem(certStorageKey, res.viewUrl);
                                    if (certActions && viewCertBtn) {
                                        viewCertBtn.href = res.viewUrl;
                                        certActions.classList.remove("d-none");
                                    }
                                    // Cập nhật lại UI Sidebar
                                    updateCompletionUI();
                                }
                            })
                            .catch(err => console.error("Lỗi cấp chứng chỉ:", err));

                        } else {
                            finalBanner.style.background = "linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(185, 28, 28, 0.25) 100%)";
                            finalBanner.style.border = "1px solid #ef4444";
                            iconWrapper.style.background = "#ef4444";
                            iconWrapper.style.color = "#ffffff";
                            icon.className = "bi bi-exclamation-triangle-fill";
                            title.className = "fw-bold mb-1 text-danger";
                            title.textContent = `CHƯA ĐẠT CHUẨN TỐT NGHIỆP (CẦN TỐI THIỂU ${passingScore} ĐIỂM)`;
                            subtitle.className = "mb-0 small text-slate-300";
                            subtitle.textContent = `Bạn đạt ${scorePct}%. Để được cấp Chứng chỉ tốt nghiệp chính thức, bạn cần đạt tối thiểu ${passingScore} điểm. Hãy kiểm tra giải thích và làm lại bài thi.`;
                            if (certActions) certActions.classList.add("d-none");
                        }

                        finalBanner.scrollIntoView({ behavior: "smooth", block: "nearest" });
                    }
                });

                if (retryFinalBtn) {
                    retryFinalBtn.addEventListener("click", function () {
                        finalForm.reset();
                        document.querySelectorAll(".final-option-label").forEach(lbl => {
                            lbl.style.background = "rgba(255, 255, 255, 0.02)";
                            lbl.style.borderColor = "rgba(255, 255, 255, 0.08)";
                        });
                        document.querySelectorAll(".final-explanation-box").forEach(box => {
                            box.style.display = "none";
                        });
                        if (finalBanner) finalBanner.style.display = "none";
                    });
                }
            }
        });

        // ================= AI QUIZ GENERATOR FROM MATERIAL =================
        let currentAiQuestions = [];
        let aiQuizModalInstance = null;

        function getAiModal() {
            if (!aiQuizModalInstance) {
                const el = document.getElementById('aiQuizModal');
                if (el && window.bootstrap) {
                    aiQuizModalInstance = new bootstrap.Modal(el);
                }
            }
            return aiQuizModalInstance;
        }

        window.startAiQuizFromLesson = function (lessonId) {
            const modal = getAiModal();
            if (modal) modal.show();
            showAiLoading(true);

            fetch('/api/ai/quiz/generate-from-lesson', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lessonId: lessonId })
            })
            .then(res => res.json())
            .then(data => {
                showAiLoading(false);
                if (data && data.success && data.questions && data.questions.length > 0) {
                    renderAiQuiz(data);
                } else {
                    showAiError(data.message || 'Không thể tạo câu hỏi trắc nghiệm từ tài liệu này.');
                }
            })
            .catch(err => {
                showAiLoading(false);
                showAiError('Đã xảy ra lỗi kết nối với máy chủ AI.');
                console.error(err);
            });
        };

        window.startAiQuizFromCustomText = function () {
            const text = (document.getElementById('customMaterialText')?.value || '').trim();
            if (!text) {
                alert('Vui lòng dán nội dung tài liệu vào ô văn bản trước khi bấm tạo.');
                return;
            }

            const modal = getAiModal();
            if (modal) modal.show();
            showAiLoading(true);

            fetch('/api/ai/quiz/generate-from-text', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: text, title: 'Tài liệu tùy chỉnh' })
            })
            .then(res => res.json())
            .then(data => {
                showAiLoading(false);
                if (data && data.success && data.questions && data.questions.length > 0) {
                    renderAiQuiz(data);
                } else {
                    showAiError(data.message || 'Không thể tạo câu hỏi từ nội dung này.');
                }
            })
            .catch(err => {
                showAiLoading(false);
                showAiError('Đã xảy ra lỗi kết nối với máy chủ AI.');
                console.error(err);
            });
        };

        function showAiLoading(isLoading) {
            const loadingEl = document.getElementById('aiQuizLoading');
            const contentEl = document.getElementById('aiQuizContent');
            const errorEl = document.getElementById('aiQuizError');
            if (loadingEl) loadingEl.style.display = isLoading ? 'block' : 'none';
            if (contentEl) contentEl.style.display = isLoading ? 'none' : 'block';
            if (errorEl) errorEl.style.display = 'none';
        }

        function showAiError(msg) {
            const errorEl = document.getElementById('aiQuizError');
            const contentEl = document.getElementById('aiQuizContent');
            if (contentEl) contentEl.style.display = 'none';
            if (errorEl) {
                errorEl.style.display = 'block';
                errorEl.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i>${msg}`;
            }
        }

        function renderAiQuiz(data) {
            currentAiQuestions = data.questions || [];
            document.getElementById('aiMaterialTitle').textContent = data.materialName || 'Tài liệu học tập';
            document.getElementById('aiLessonSubtitle').textContent = data.lessonTitle || '';
            const container = document.getElementById('aiQuestionsContainer');
            const resultBox = document.getElementById('aiQuizResultBox');
            if (resultBox) resultBox.style.display = 'none';

            let html = '';
            currentAiQuestions.forEach((q, qIdx) => {
                html += `
                    <div class="ai-question-card mb-4 p-3 p-md-4 rounded-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);" id="aiQCard_${qIdx}">
                        <div class="d-flex align-items-start gap-2 mb-3">
                            <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">Câu ${qIdx + 1}</span>
                            <h6 class="fw-bold text-white mb-0 mt-0.5" style="line-height: 1.5;">${escapeHtml(q.question)}</h6>
                        </div>
                        <div class="d-flex flex-column gap-2">
                `;

                (q.options || []).forEach((opt, optIdx) => {
                    const optLetter = String.fromCharCode(65 + optIdx);
                    html += `
                        <label class="ai-opt-label p-3 rounded-3 d-flex align-items-center gap-3 cursor-pointer" 
                               style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); transition: all 0.2s;" 
                               id="aiOptLabel_${qIdx}_${optIdx}">
                            <input type="radio" name="aiAns_${qIdx}" value="${optIdx}" class="form-check-input mt-0" style="border-color: rgba(255,255,255,0.3);">
                            <span class="fw-bold text-primary">${optLetter}.</span>
                            <span class="text-slate-200" style="font-size: 0.95rem;">${escapeHtml(opt)}</span>
                        </label>
                    `;
                });

                html += `
                        </div>
                        <div class="ai-exp-box mt-3 p-3 rounded-3 small" id="aiExp_${qIdx}" style="display: none; background: rgba(16, 185, 129, 0.1); border-left: 3px solid #10b981; color: #cbd5e1;">
                            <strong class="text-success d-block mb-1"><i class="bi bi-lightbulb-fill me-1"></i>Giải thích từ tài liệu:</strong>
                            ${escapeHtml(q.explanation || 'Đáp án chính xác theo tài liệu bài học.')}
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        window.submitAiQuiz = function () {
            if (!currentAiQuestions || currentAiQuestions.length === 0) return;

            let correctCount = 0;
            currentAiQuestions.forEach((q, qIdx) => {
                const selected = document.querySelector(`input[name="aiAns_${qIdx}"]:checked`);
                const expBox = document.getElementById(`aiExp_${qIdx}`);
                const isCorrect = selected && parseInt(selected.value) === q.correctAnswerIndex;

                if (isCorrect) correctCount++;

                // Đổi màu các options
                (q.options || []).forEach((_, optIdx) => {
                    const lbl = document.getElementById(`aiOptLabel_${qIdx}_${optIdx}`);
                    if (!lbl) return;
                    if (optIdx === q.correctAnswerIndex) {
                        lbl.style.background = 'rgba(16, 185, 129, 0.2)';
                        lbl.style.borderColor = '#10b981';
                    } else if (selected && parseInt(selected.value) === optIdx) {
                        lbl.style.background = 'rgba(239, 68, 68, 0.2)';
                        lbl.style.borderColor = '#ef4444';
                    } else {
                        lbl.style.opacity = '0.5';
                    }
                });

                if (expBox) expBox.style.display = 'block';
            });

            const total = currentAiQuestions.length;
            const pct = Math.round((correctCount / total) * 100);
            const resultBox = document.getElementById('aiQuizResultBox');
            const scoreText = document.getElementById('aiScoreText');
            const titleText = document.getElementById('aiResultTitle');

            if (resultBox && scoreText && titleText) {
                resultBox.style.display = 'block';
                scoreText.textContent = `${correctCount}/${total} câu (${pct}%)`;
                if (pct >= 80) {
                    titleText.className = 'fw-bold text-success mb-1';
                    titleText.textContent = 'XUẤT SẮC! BẠN ĐÃ NẮM VỮNG KIẾN THỨC TÀI LIỆU';
                } else if (pct >= 50) {
                    titleText.className = 'fw-bold text-warning mb-1';
                    titleText.textContent = 'ĐẠT YÊU CẦU - CẦN ĐỌC LẠI CÁC Ý QUAN TRỌNG';
                } else {
                    titleText.className = 'fw-bold text-danger mb-1';
                    titleText.textContent = 'CẦN ÔN TẬP THÊM TÀI LIỆU';
                }
                resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        };

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>

    <!-- Modal AI Quiz Generator -->
    <div class="modal fade" id="aiQuizModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="aiQuizModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content text-white" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: rgba(37, 99, 235, 0.15); color: #3b82f6;">
                            <i class="bi bi-stars fs-4 text-warning"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0" id="aiQuizModalLabel">AI Quiz Generator từ Tài liệu</h5>
                            <span class="small text-slate-400" id="aiLessonSubtitle" style="color: #94a3b8; font-size: 0.8rem;"></span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    <!-- Loading State -->
                    <div id="aiQuizLoading" class="text-center py-5">
                        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                            <span class="visually-hidden">Đang xử lý...</span>
                        </div>
                        <h5 class="fw-bold text-white mb-2">Trợ lý AI đang đọc và phân tích tài liệu...</h5>
                        <p class="text-slate-400 small mb-0" style="color: #94a3b8; max-width: 420px; margin: 0 auto;">
                            Hệ thống đang trích xuất các khái niệm cốt lõi, công thức và kỹ thuật quan trọng để tự động tạo 5 câu hỏi trắc nghiệm thực chiến bám sát tài liệu.
                        </p>
                    </div>

                    <!-- Error State -->
                    <div id="aiQuizError" class="alert alert-danger rounded-3" style="display: none;"></div>

                    <!-- Content State -->
                    <div id="aiQuizContent" style="display: none;">
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-4" style="background: rgba(37, 99, 235, 0.08); border: 1px solid rgba(37, 99, 235, 0.2);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check-fill text-warning fs-5"></i>
                                <div>
                                    <span class="small text-slate-400 d-block" style="font-size: 0.75rem;">Nguồn học liệu đã phân tích:</span>
                                    <strong class="text-white" id="aiMaterialTitle">Tài liệu bài học</strong>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 small">
                                <i class="bi bi-check2-all me-1"></i>Đã sinh 5 câu hỏi
                            </span>
                        </div>

                        <!-- Result Banner -->
                        <div id="aiQuizResultBox" class="p-4 rounded-4 mb-4 text-center" style="display: none; background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981;">
                            <h5 id="aiResultTitle" class="fw-bold text-success mb-1">KẾT QUẢ ĐÁNH GIÁ</h5>
                            <div class="fs-4 fw-black text-white mb-2" id="aiScoreText">0/5 câu</div>
                            <p class="small text-slate-300 mb-0">Hãy đối chiếu từng câu hỏi bên dưới để xem đáp án đúng và lời giải thích chi tiết trích dẫn từ tài liệu.</p>
                        </div>

                        <!-- Questions Container -->
                        <div id="aiQuestionsContainer"></div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" onclick="submitAiQuiz()">
                        <i class="bi bi-send-check-fill"></i>
                        <span>Nộp bài & Chấm điểm</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
