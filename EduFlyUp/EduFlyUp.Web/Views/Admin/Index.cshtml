@model EduFlyUp.Web.Models.Admin.AdminDashboardModel
@{
    ViewData["Title"] = "Bảng điều khiển Admin";
    Layout = "_AdminLayout";
    var users = new[]
    {
        new { Key = "total-users", Label = "Tổng người dùng", Count = Model.Stats.TotalUsers, Active = (bool?)null, Color = "primary" },
        new { Key = "active-users", Label = "Đang hoạt động", Count = Model.Stats.ActiveUsers, Active = (bool?)true, Color = "success" },
        new { Key = "inactive-users", Label = "Đã khóa", Count = Model.Stats.InactiveUsers, Active = (bool?)false, Color = "danger" }
    };
    var courses = new[]
    {
        new { Key = "total-courses", Label = "Tổng khóa học", Count = Model.Stats.TotalCourses, Published = (bool?)null, Color = "primary" },
        new { Key = "published-courses", Label = "Đang công khai", Count = Model.Stats.PublishedCourses, Published = (bool?)true, Color = "success" },
        new { Key = "hidden-courses", Label = "Ẩn / chưa công khai", Count = Model.Stats.HiddenCourses, Published = (bool?)false, Color = "secondary" }
    };
}

<section class="rounded-4 p-4 p-lg-5 text-white mb-4" style="background:linear-gradient(120deg,#0f172a,#312e81)">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="h2 fw-bold mb-2">Bảng điều khiển Admin</h1>
            <p class="mb-0">Tổng quan người dùng, khóa học và nội dung đào tạo.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>Tải lại số liệu</a>
    </div>
</section>

<p class="text-muted small mb-4">Số liệu cập nhật khi tải trang. Hoạt động là trạng thái quản trị của tài khoản, độc lập với khóa tạm thời do nhập sai mật khẩu.</p>

<section class="mb-4" aria-labelledby="users-heading">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 id="users-heading" class="h5 fw-bold mb-0">Người dùng</h2>
        <a asp-action="Users" class="btn btn-sm btn-outline-primary">Quản lý người dùng</a>
    </div>
    <div class="row g-3">
        @foreach (var metric in users)
        {
            <div class="col-md-4">
                <a asp-action="Users" asp-route-IsActive="@metric.Active" class="card h-100 text-decoration-none text-body border-@metric.Color rounded-4 shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="h6 text-muted">@metric.Label</h3>
                        <strong class="display-6 fw-bold d-block mb-3 text-@metric.Color" data-testid="@metric.Key">@metric.Count.ToString("N0")</strong>
                        <span class="small">Xem danh sách <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-4" aria-labelledby="courses-heading">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 id="courses-heading" class="h5 fw-bold mb-0">Khóa học</h2>
        <a asp-action="Courses" class="btn btn-sm btn-outline-primary">Quản lý khóa học</a>
    </div>
    <div class="row g-3">
        @foreach (var metric in courses)
        {
            <div class="col-md-4">
                <a asp-action="Courses" asp-route-IsPublished="@metric.Published" class="card h-100 text-decoration-none text-body border-@metric.Color rounded-4 shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="h6 text-muted">@metric.Label</h3>
                        <strong class="display-6 fw-bold d-block mb-3 text-@metric.Color" data-testid="@metric.Key">@metric.Count.ToString("N0")</strong>
                        <span class="small">Xem danh sách <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<section class="card rounded-4 shadow-sm" aria-labelledby="lessons-heading">
    <div class="card-body p-4 d-flex flex-wrap align-items-center gap-4">
        <i class="bi bi-journal-text fs-1 text-primary" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <h2 id="lessons-heading" class="h6 fw-bold">Tổng bài học</h2>
            <p class="text-muted small mb-0">Bao gồm bài học trong khóa học công khai và khóa học ẩn.</p>
        </div>
        <strong class="display-6 fw-bold text-primary" data-testid="total-lessons">@Model.Stats.TotalLessons.ToString("N0")</strong>
    </div>
</section>
