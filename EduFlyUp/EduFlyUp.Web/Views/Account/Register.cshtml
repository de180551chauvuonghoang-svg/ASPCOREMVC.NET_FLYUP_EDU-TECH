@model EduFlyUp.Web.Models.Account.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - EduFlyUp";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-modern p-4 p-md-5 border-0 shadow-lg position-relative overflow-hidden">
            <!-- Ambient Top Border Glow -->
            <div class="position-absolute top-0 start-0 end-0" style="height: 5px; background: var(--brand-gradient);"></div>

            <div class="text-center mb-4 pt-2">
                <div class="brand-icon-wrapper mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem; border-radius: 16px;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h3 class="fw-bold mb-1">Tạo tài khoản mới</h3>
                <p class="text-muted small">Bắt đầu hành trình chinh phục kiến trúc .NET 8 ngay hôm nay</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small border-0 shadow-xs mb-3" role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold text-dark">Họ và tên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="FullName" class="form-control rounded-end-3 border-start-0 ps-0" placeholder="Nguyễn Văn A" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-dark">Địa chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control rounded-end-3 border-start-0 ps-0" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-dark">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control rounded-end-3 border-start-0 ps-0" placeholder="Tối thiểu 6 ký tự..." />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-dark">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-shield-check"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-end-3 border-start-0 ps-0" placeholder="Nhập lại mật khẩu..." />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100 py-3 rounded-pill shadow-glow fw-bold">
                    <i class="bi bi-person-check-fill me-1"></i>Đăng ký tài khoản
                </button>
            </form>

            <div class="text-center mt-4 pt-2 border-top">
                <span class="text-muted small">Đã có tài khoản?</span>
                <a asp-action="Login" class="small fw-bold text-primary text-decoration-none ms-1">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
