@model EduFlyUp.Web.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Đăng Nhập / Đăng Ký - EduFlyUp";
    ViewData["FullWidth"] = true;
    ViewData["HideFooter"] = true;
}

<div class="auth-slider-wrapper">
    <!-- Live Photo Dynamic Animated Background -->
    <div class="live-photo-container">
        <div class="live-photo-media"></div>
        <div class="live-photo-overlay"></div>
    </div>

    <!-- Sliding Auth Card Container -->
    <div class="auth-slider-card shadow-2xl" id="authSliderCard">

        <!-- Mobile Switch Tabs -->
        <div class="mobile-switch-nav d-lg-none px-3 pt-3">
            <button type="button" class="mobile-switch-btn active" id="mobileLoginBtn">Đăng Nhập</button>
            <button type="button" class="mobile-switch-btn" id="mobileRegisterBtn">Đăng Ký</button>
        </div>

        <!-- 1. SIGN IN FORM PANEL -->
        <div class="auth-form-panel panel-sign-in">
            <div class="text-start mb-3">
                <div class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill mb-2 fw-bold" style="background: rgba(79, 70, 229, 0.08); border: 1px solid rgba(79, 70, 229, 0.2); color: #4f46e5; font-size: 0.75rem;">
                    <i class="bi bi-shield-lock-fill text-primary"></i>
                    <span>EduFlyUp Security</span>
                </div>
                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.85rem; letter-spacing: -0.02em;">Đăng Nhập</h2>
                <p class="text-secondary small mb-0" style="font-size: 0.88rem; line-height: 1.45;">Chào mừng trở lại! Vui lòng nhập thông tin để đăng nhập vào hệ thống.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="signInForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small border-0 mb-3" role="alert"></div>
                }

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-dark mb-1">Địa chỉ Email</label>
                    <div class="input-group auth-input-wrapper">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" id="loginEmail" type="email" class="form-control" placeholder="admin@eduflyup.vn" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label small fw-semibold text-dark mb-0">Mật khẩu</label>
                        <a href="#" class="small text-primary text-decoration-none fw-semibold">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group auth-input-wrapper position-relative">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" id="loginPassword" type="password" class="form-control pe-5" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="auth-toggle-pwd" id="toggleLoginPwd" title="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye" id="iconLoginPwd"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Remember Me & One-click Demo Fills -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">Ghi nhớ</label>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="quick-demo-pill border-0" id="btnFillAdmin" title="Điền Admin">
                            <i class="bi bi-shield-lock-fill text-warning"></i> Admin
                        </button>
                        <button type="button" class="quick-demo-pill border-0" id="btnFillInstructor" title="Điền Instructor">
                            <i class="bi bi-person-video3 text-success"></i> Instructor
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-brand w-100 py-3 rounded-pill shadow-glow fw-bold mb-3 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%) !important; color: #ffffff !important; border: none !important; font-size: 1rem;">
                    <span class="text-white">Đăng Nhập Ngay</span>
                    <i class="bi bi-arrow-right-short fs-4 text-white"></i>
                </button>
            </form>

            <!-- Quick Demo Credentials Hint Bar -->
            <div class="p-2 px-3 rounded-3 border d-flex align-items-center justify-content-between text-secondary" style="background: #f8fafc; font-size: 0.76rem;">
                <span class="text-muted d-flex align-items-center gap-1">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span>Tài khoản mẫu:</span>
                </span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white text-dark border px-2 py-1 shadow-2xs">Admin: <strong class="text-primary">Admin@123</strong></span>
                    <span class="badge bg-white text-dark border px-2 py-1 shadow-2xs">Instructor: <strong class="text-success">Instructor@123</strong></span>
                </div>
            </div>

            <div class="text-center mt-auto pt-2 border-top d-lg-none">
                <span class="text-muted small">Chưa có tài khoản?</span>
                <button type="button" class="btn btn-link p-0 small fw-bold text-primary text-decoration-none ms-1" id="linkToRegister">Đăng ký ngay</button>
            </div>
        </div>

        <!-- 2. SIGN UP FORM PANEL (Slides from left on desktop) -->
        <div class="auth-form-panel panel-sign-up">
            <div class="text-start mb-2">
                <div class="d-inline-flex align-items-center justify-content-center p-1 px-3 rounded-pill bg-success bg-opacity-10 text-success mb-2 small fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-mortarboard-fill me-1"></i> Thành viên mới
                </div>
                <h2 class="fw-bold text-heading mb-1" style="font-size: 1.75rem;">Tạo Tài Khoản</h2>
                <p class="text-muted small mb-0">Khám phá các khóa học lập trình .NET chất lượng cao.</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" id="signUpForm">
                @Html.AntiForgeryToken()

                <!-- Role Selection -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Vai trò tài khoản</label>
                    <div class="d-flex gap-2">
                        <label class="btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1 active role-radio-label" style="font-size: 0.78rem; border-radius: 10px; padding: 5px;">
                            <input type="radio" name="Role" value="Student" class="d-none" checked />
                            <i class="bi bi-backpack"></i> Học viên
                        </label>
                        <label class="btn btn-outline-success btn-sm flex-fill d-flex align-items-center justify-content-center gap-1 role-radio-label" style="font-size: 0.78rem; border-radius: 10px; padding: 5px;">
                            <input type="radio" name="Role" value="Instructor" class="d-none" />
                            <i class="bi bi-person-video3"></i> Giảng viên
                        </label>
                    </div>
                </div>

                <!-- Full Name -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Họ và tên</label>
                    <div class="input-group auth-input-wrapper">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input name="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Email</label>
                    <div class="input-group auth-input-wrapper">
                        <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                        <input name="Email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>
                </div>

                <!-- Password -->
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark mb-1">Mật khẩu</label>
                        <div class="input-group auth-input-wrapper position-relative">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input name="Password" id="regPassword" type="password" class="form-control pe-4" placeholder="••••••" required minlength="6" />
                            <button type="button" class="auth-toggle-pwd" id="toggleRegPwd" title="Hiện/ẩn">
                                <i class="bi bi-eye" id="iconRegPwd"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark mb-1">Nhập lại</label>
                        <div class="input-group auth-input-wrapper position-relative">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input name="ConfirmPassword" id="regConfirmPassword" type="password" class="form-control pe-4" placeholder="••••••" required minlength="6" />
                            <button type="button" class="auth-toggle-pwd" id="toggleRegConfirmPwd" title="Hiện/ẩn">
                                <i class="bi bi-eye" id="iconRegConfirmPwd"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Terms Checkbox -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="termsCheck" required checked />
                    <label class="form-check-label small text-muted" for="termsCheck">
                        Đồng ý với <a href="#" class="text-primary text-decoration-none">Điều khoản sử dụng</a>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-brand w-100 py-3 rounded-pill shadow-glow fw-bold mb-2 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%) !important; color: #ffffff !important; border: none !important; font-size: 1rem;">
                    <i class="bi bi-rocket-takeoff-fill text-white"></i>
                    <span class="text-white">Tạo Tài Khoản Ngay</span>
                </button>
            </form>

            <div class="text-center mt-auto pt-2 border-top d-lg-none">
                <span class="text-muted small">Đã có tài khoản?</span>
                <button type="button" class="btn btn-link p-0 small fw-bold text-primary text-decoration-none ms-1" id="linkToLogin">Đăng nhập</button>
            </div>
        </div>

        <!-- 3. SLIDING OVERLAY CONTAINER (Desktop Only) -->
        <div class="auth-overlay-container d-none d-lg-block">
            <div class="auth-overlay">
                <!-- Overlay Left Panel (Shown when viewing Sign Up) -->
                <div class="auth-overlay-panel auth-overlay-left">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center px-4 py-2 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25 shadow-sm">
                        <span class="fw-black fs-3 text-white" style="letter-spacing: 2px; font-weight: 900;">FLY<span style="color: #818cf8;">UP</span></span>
                    </div>
                    <h2 class="fw-bold text-white mb-3">Đã Có Tài Khoản?</h2>
                    <p class="text-light opacity-75 mb-4" style="max-width: 320px; font-size: 0.95rem;">
                        Để tiếp tục theo dõi tiến độ học tập và các bài giảng của bạn, vui lòng đăng nhập ngay.
                    </p>
                    <button type="button" class="btn btn-outline-light rounded-pill px-5 py-2 fw-bold" id="btnSlideToSignIn">
                        <i class="bi bi-arrow-left me-1"></i> Đăng Nhập
                    </button>
                </div>

                <!-- Overlay Right Panel (Shown when viewing Sign In) -->
                <div class="auth-overlay-panel auth-overlay-right">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center px-4 py-2 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25 shadow-sm">
                        <span class="fw-black fs-3 text-white" style="letter-spacing: 2px; font-weight: 900;">FLY<span style="color: #818cf8;">UP</span></span>
                    </div>
                    <h2 class="fw-bold text-white mb-3">Xin Chào Bạn Mới!</h2>
                    <p class="text-light opacity-75 mb-4" style="max-width: 320px; font-size: 0.95rem;">
                        Nhập thông tin cá nhân và bắt đầu hành trình chinh phục kiến trúc .NET chuyên nghiệp cùng EduFlyUp.
                    </p>
                    <button type="button" class="btn btn-outline-light rounded-pill px-5 py-2 fw-bold" id="btnSlideToSignUp">
                        Đăng Ký Ngay <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Sliding Overlay Controller
            const card = document.getElementById("authSliderCard");
            const btnSlideToSignUp = document.getElementById("btnSlideToSignUp");
            const btnSlideToSignIn = document.getElementById("btnSlideToSignIn");
            const mobileLoginBtn = document.getElementById("mobileLoginBtn");
            const mobileRegisterBtn = document.getElementById("mobileRegisterBtn");
            const linkToRegister = document.getElementById("linkToRegister");
            const linkToLogin = document.getElementById("linkToLogin");

            function switchToRegister() {
                card.classList.add("right-panel-active");
                if (mobileRegisterBtn) {
                    mobileRegisterBtn.classList.add("active");
                    mobileLoginBtn.classList.remove("active");
                }
            }

            function switchToLogin() {
                card.classList.remove("right-panel-active");
                if (mobileLoginBtn) {
                    mobileLoginBtn.classList.add("active");
                    mobileRegisterBtn.classList.remove("active");
                }
            }

            if (btnSlideToSignUp) btnSlideToSignUp.addEventListener("click", switchToRegister);
            if (btnSlideToSignIn) btnSlideToSignIn.addEventListener("click", switchToLogin);
            if (mobileRegisterBtn) mobileRegisterBtn.addEventListener("click", switchToRegister);
            if (mobileLoginBtn) mobileLoginBtn.addEventListener("click", switchToLogin);
            if (linkToRegister) linkToRegister.addEventListener("click", switchToRegister);
            if (linkToLogin) linkToLogin.addEventListener("click", switchToLogin);

            // 2. Role Selector Toggle
            document.querySelectorAll(".role-radio-label input[type='radio']").forEach(radio => {
                radio.addEventListener("change", function () {
                    document.querySelectorAll(".role-radio-label").forEach(l => l.classList.remove("active"));
                    if (this.checked) {
                        this.closest(".role-radio-label").classList.add("active");
                    }
                });
            });

            // 3. Password Visibility Helpers
            function setupPasswordToggle(btnId, inputId, iconId) {
                const btn = document.getElementById(btnId);
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                if (btn && input && icon) {
                    btn.addEventListener("click", function () {
                        const isPwd = input.type === "password";
                        input.type = isPwd ? "text" : "password";
                        icon.className = isPwd ? "bi bi-eye-slash text-primary" : "bi bi-eye";
                    });
                }
            }
            setupPasswordToggle("toggleLoginPwd", "loginPassword", "iconLoginPwd");
            setupPasswordToggle("toggleRegPwd", "regPassword", "iconRegPwd");
            setupPasswordToggle("toggleRegConfirmPwd", "regConfirmPassword", "iconRegConfirmPwd");

            // 4. Quick Fill Credentials
            const btnFillAdmin = document.getElementById("btnFillAdmin");
            const btnFillInstructor = document.getElementById("btnFillInstructor");
            const emailInput = document.getElementById("loginEmail");
            const pwdInput = document.getElementById("loginPassword");

            if (btnFillAdmin && emailInput && pwdInput) {
                btnFillAdmin.addEventListener("click", function () {
                    emailInput.value = "admin@eduflyup.vn";
                    pwdInput.value = "Admin@123";
                    emailInput.dispatchEvent(new Event('input', { bubbles: true }));
                    pwdInput.dispatchEvent(new Event('input', { bubbles: true }));

                    btnFillAdmin.classList.add("bg-success", "text-white");
                    btnFillAdmin.innerHTML = '<i class="bi bi-check-lg"></i> Xong!';
                    setTimeout(() => {
                        btnFillAdmin.classList.remove("bg-success", "text-white");
                        btnFillAdmin.innerHTML = '<i class="bi bi-shield-lock-fill text-warning"></i> Admin';
                    }, 1400);
                });
            }

            if (btnFillInstructor && emailInput && pwdInput) {
                btnFillInstructor.addEventListener("click", function () {
                    emailInput.value = "instructor@eduflyup.vn";
                    pwdInput.value = "Instructor@123";
                    emailInput.dispatchEvent(new Event('input', { bubbles: true }));
                    pwdInput.dispatchEvent(new Event('input', { bubbles: true }));

                    btnFillInstructor.classList.add("bg-success", "text-white");
                    btnFillInstructor.innerHTML = '<i class="bi bi-check-lg"></i> Xong!';
                    setTimeout(() => {
                        btnFillInstructor.classList.remove("bg-success", "text-white");
                        btnFillInstructor.innerHTML = '<i class="bi bi-person-video3 text-success"></i> Instructor';
                    }, 1400);
                });
            }
        });
    </script>
}
