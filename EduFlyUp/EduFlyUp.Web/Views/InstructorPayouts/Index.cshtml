@using EduFlyUp.Web.Models.Instructor
@using System.Globalization
@model EduFlyUp.BusinessObjects.InstructorPayoutHistory
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Lịch sử rút tiền"; }
<div class="mb-4"><h1 class="h3 fw-bold">Lịch sử rút tiền của tôi</h1><p class="text-muted">Theo dõi các yêu cầu rút tiền và phản hồi từ Admin. Thời gian theo giờ Việt Nam (UTC+7).</p></div>
<div class="card card-modern border-0 shadow-sm overflow-hidden">
    <div class="p-3 border-bottom text-muted">Tổng cộng @Model.TotalCount yêu cầu · Trang @Model.Page/@Model.TotalPages</div>
    @if (Model.Items.Count == 0)
    {
        <div class="p-5 text-center"><h2 class="h5">Chưa có yêu cầu rút tiền</h2><p class="text-muted mb-0">Các yêu cầu rút tiền của bạn sẽ hiển thị tại đây.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr>
            <th scope="col">Mã yêu cầu</th><th scope="col">Số tiền (VNĐ)</th><th scope="col">Trạng thái</th><th scope="col">Ngày gửi</th><th scope="col">Ngày xử lý</th><th scope="col">Phản hồi từ Admin</th>
        </tr></thead><tbody>
        @foreach (var payout in Model.Items)
        {
            <tr><th scope="row">#@payout.Id</th><td class="fw-semibold text-nowrap">@payout.Amount.ToString("N2", CultureInfo.GetCultureInfo("vi-VN"))</td>
                <td>@InstructorPayoutDisplay.Status(payout.Status)</td><td class="small text-nowrap">@InstructorReportDisplay.VietnamTime(payout.CreatedAt)</td>
                <td class="small text-nowrap">@(payout.ProcessedAt.HasValue ? InstructorReportDisplay.VietnamTime(payout.ProcessedAt.Value) : "—")</td>
                <td class="text-break">@(string.IsNullOrWhiteSpace(payout.AdminNote) ? "—" : payout.AdminNote)</td></tr>
        }
        </tbody></table></div>
        <nav class="d-flex gap-2 justify-content-end p-3" aria-label="Phân trang lịch sử rút tiền">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn btn-sm btn-outline-secondary">Trang trước</a> }
            @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary">Trang sau</a> }
        </nav>
    }
</div>
