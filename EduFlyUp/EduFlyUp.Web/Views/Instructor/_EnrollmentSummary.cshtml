@model EduFlyUp.BusinessObjects.InstructorEnrollmentSummary
<section class="mb-4" aria-labelledby="enrollmentSummaryTitle" id="enrollment-summary">
    <div class="card card-modern border-0 shadow-sm p-3 p-md-4 rounded-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 class="h5 fw-bold mb-1 d-flex align-items-center gap-2" id="enrollmentSummaryTitle">
                    <i class="bi bi-people-fill text-primary"></i>
                    <span>Thống kê học viên của tôi</span>
                </h2>
                <p class="text-muted small mb-0">Tổng hợp toàn bộ khóa học bạn phụ trách, bao gồm khóa đã lưu trữ.</p>
            </div>
            <a asp-controller="InstructorStudents" asp-action="Courses" class="btn btn-sm btn-outline-brand rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                <span>Xem danh sách học viên</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-4">
                <div class="card border rounded-4 p-3 h-100 bg-light bg-opacity-50 border-start border-primary border-4">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Tổng lượt ghi danh</span>
                    <strong class="h3 fw-bold text-primary mt-2 mb-1" id="total-enrollments">@Model.TotalEnrollments</strong>
                    <span class="text-muted small">Gồm đang học, hoàn thành và đã hủy.</span>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card border rounded-4 p-3 h-100 bg-light bg-opacity-50 border-start border-success border-4">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Học viên không trùng</span>
                    <strong class="h3 fw-bold text-success mt-2 mb-1" id="unique-students">@Model.UniqueStudents</strong>
                    <span class="text-muted small">Tính theo từng tài khoản học viên.</span>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card border rounded-4 p-3 h-100 bg-light bg-opacity-50 border-start border-info border-4">
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Trạng thái ghi danh</span>
                    <dl class="mb-0 mt-2 small">
                        <div class="d-flex justify-content-between gap-2 mb-1"><dt class="fw-normal text-secondary">Đang học</dt><dd class="fw-bold text-dark mb-0" id="active-enrollments">@Model.ActiveEnrollments</dd></div>
                        <div class="d-flex justify-content-between gap-2 mb-1"><dt class="fw-normal text-secondary">Đã hoàn thành</dt><dd class="fw-bold text-success mb-0" id="completed-enrollments">@Model.CompletedEnrollments</dd></div>
                        <div class="d-flex justify-content-between gap-2"><dt class="fw-normal text-secondary">Đã hủy</dt><dd class="fw-bold text-muted mb-0" id="cancelled-enrollments">@Model.CancelledEnrollments</dd></div>
                    </dl>
                </div>
            </div>
        </div>
        @if (Model.TotalEnrollments == 0)
        {
            <p class="text-muted small mt-3 mb-0">Chưa có lượt ghi danh trong các khóa học của bạn.</p>
        }
    </div>
</section>
