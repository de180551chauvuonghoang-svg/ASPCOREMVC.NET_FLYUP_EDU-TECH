@using EduFlyUp.BusinessObjects
@model IEnumerable<Course>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kênh Giảng Viên - EduFlyUp";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var categories = (ViewBag.Categories as IEnumerable<string>) ?? Enumerable.Empty<string>();
}

<!-- Hero Banner -->
<div class="card card-modern brand-hero-banner p-4 p-md-5 mb-4 border-0 shadow-sm rounded-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 mb-3 flex-wrap">
                <span class="badge badge-brand-soft px-3 py-2 rounded-pill fw-bold">
                    <i class="bi bi-mortarboard-fill me-1"></i>Kênh Giảng Viên
                </span>
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-person-circle text-primary me-1"></i>@User.Identity?.Name
                </span>
            </div>
            <h1 class="display-6 fw-bold mb-2 text-dark">Quản Lý Khóa Học Giảng Viên</h1>
            <p class="text-secondary mb-0 fs-6" style="max-width: 650px;">
                Biên soạn giáo trình, quản lý ngân hàng câu hỏi, gửi duyệt xuất bản và theo dõi tình hình học tập trên từng khóa học.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0 d-flex flex-wrap gap-2 justify-content-lg-end">
            <a asp-controller="Courses" asp-action="Create" class="btn btn-brand rounded-pill px-4 py-3 shadow-glow d-inline-flex align-items-center gap-2 fw-bold">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>Tạo khóa học mới</span>
            </a>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-brand rounded-pill px-3 py-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-eye fs-5"></i>
                <span>Xem trang học viên</span>
            </a>
        </div>
    </div>
</div>

<!-- 4 Key Instructor Metric Cards -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-modern p-4 border-start border-primary border-4 shadow-sm h-100 rounded-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Khóa học của tôi</span>
                    <h2 class="fw-bold text-primary mt-1 mb-0">@ViewBag.TotalCourses</h2>
                </div>
                <div class="bg-primary-subtle p-3 rounded-circle text-primary fs-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-modern p-4 border-start border-success border-4 shadow-sm h-100 rounded-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Đang mở bán</span>
                    <h2 class="fw-bold text-success mt-1 mb-0">@ViewBag.ApprovedCourses</h2>
                </div>
                <div class="bg-success-subtle p-3 rounded-circle text-success fs-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-modern p-4 border-start border-warning border-4 shadow-sm h-100 rounded-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Chờ Admin duyệt</span>
                    <h2 class="fw-bold text-warning-emphasis mt-1 mb-0">@ViewBag.PendingApprovalCourses</h2>
                </div>
                <div class="bg-warning-subtle p-3 rounded-circle text-warning fs-3">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-modern p-4 border-start border-info border-4 shadow-sm h-100 rounded-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase tracking-wider">Tổng bài giảng</span>
                    <h2 class="fw-bold text-info mt-1 mb-0">@ViewBag.TotalLessons</h2>
                </div>
                <div class="bg-info-subtle p-3 rounded-circle text-info fs-3">
                    <i class="bi bi-collection-play-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card card-modern p-3 mb-4 shadow-sm border-0 rounded-4">
    <form method="get" asp-action="Dashboard" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted rounded-start-pill">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="instructorCourseSearch" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 rounded-end-pill" placeholder="Tìm theo tiêu đề, mô tả..." autocomplete="off" />
            </div>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select rounded-pill" onchange="this.form.submit()">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@(ViewBag.CurrentCategory == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="level" class="form-select rounded-pill" onchange="this.form.submit()">
                <option value="">Tất cả cấp độ</option>
                <option value="Beginner" selected="@(ViewBag.CurrentLevel == "Beginner")">Cơ bản</option>
                <option value="Intermediate" selected="@(ViewBag.CurrentLevel == "Intermediate")">Trung bình</option>
                <option value="Advanced" selected="@(ViewBag.CurrentLevel == "Advanced")">Nâng cao</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select rounded-pill" onchange="this.form.submit()">
                <option value="">Tất cả trạng thái</option>
                <option value="Draft" selected="@(ViewBag.CurrentStatus == "Draft")">Bản nháp</option>
                <option value="PendingApproval" selected="@(ViewBag.CurrentStatus == "PendingApproval")">Chờ duyệt</option>
                <option value="Approved" selected="@(ViewBag.CurrentStatus == "Approved")">Đang mở bán</option>
                <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">Bị từ chối</option>
                <option value="Archived" selected="@(ViewBag.CurrentStatus == "Archived")">Đã lưu trữ</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-brand rounded-pill w-100 py-2">
                <i class="bi bi-funnel-fill me-1"></i>Lọc
            </button>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3 py-2" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Courses Management Table -->
<div class="card card-modern shadow-sm overflow-hidden border-0 rounded-4 mb-5">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            <span>Danh Sách Khóa Học</span>
        </h5>
        <span id="courseCountBadge" class="badge badge-brand-soft rounded-pill px-3 py-2 fw-semibold">
            @Model.Count() khóa học
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th scope="col" class="ps-4 py-3">Khóa học</th>
                    <th scope="col" class="py-3">Danh mục</th>
                    <th scope="col" class="py-3">Cấp độ</th>
                    <th scope="col" class="py-3">Học phí</th>
                    <th scope="col" class="py-3">Bài giảng</th>
                    <th scope="col" class="py-3">Trạng thái</th>
                    <th scope="col" class="py-3">Ngày tạo</th>
                    <th scope="col" class="text-end pe-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="py-4">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                                <h6 class="fw-bold text-dark mb-1">Chưa có khóa học nào phù hợp</h6>
                                <p class="text-muted small mb-3">Bắt đầu chia sẻ kiến thức bằng cách tạo khóa học mới ngay hôm nay.</p>
                                <a asp-controller="Courses" asp-action="Create" class="btn btn-brand btn-sm rounded-pill px-4 py-2">
                                    <i class="bi bi-plus-lg me-1"></i>Tạo khóa học mới
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var enrollmentCounts = ViewBag.CourseEnrollmentCounts as Dictionary<int, int>;
                    @foreach (var c in Model)
                    {
                        var effectiveStatus = c.GetEffectiveStatus();
                        var enrollmentCount = enrollmentCounts != null && enrollmentCounts.TryGetValue(c.Id, out var count)
                            ? count
                            : (c.Enrollments?.Count ?? 0);

                        <tr class="course-row" data-title="@c.Title" data-desc="@c.Description">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(c.ThumbnailUrl) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=100&auto=format&fit=crop&q=80" : c.ThumbnailUrl)"
                                         alt="@c.Title"
                                         class="rounded-3 object-fit-cover shadow-xs"
                                         style="width: 56px; height: 42px;"
                                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=100&auto=format&fit=crop&q=80';" />
                                    <div>
                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="fw-bold text-dark text-decoration-none hover-primary d-block">
                                            @c.Title
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <span class="text-muted small">@c.InstructorId</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 fw-normal">
                                    <i class="bi bi-tag me-1 text-muted"></i>@(string.IsNullOrEmpty(c.Category) ? "Chung" : c.Category)
                                </span>
                            </td>
                            <td>
                                @switch (c.Level)
                                {
                                    case CourseLevel.Beginner:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 fw-medium">Cơ bản</span>
                                        break;
                                    case CourseLevel.Intermediate:
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 fw-medium">Trung bình</span>
                                        break;
                                    case CourseLevel.Advanced:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 fw-medium">Nâng cao</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (c.Price == 0)
                                {
                                    <span class="fw-bold text-success">Miễn phí</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">@c.Price.ToString("N0") VNĐ</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border rounded-pill px-2 py-1">
                                    <i class="bi bi-play-circle me-1"></i>@(c.Lessons?.Count ?? 0) bài
                                </span>
                            </td>
                            <td>
                                <partial name="_CourseStatusBadge" model="(c.Status, c.IsPublished, c.RejectionReason, false)" />
                                @if (effectiveStatus == CourseStatus.Rejected && !string.IsNullOrWhiteSpace(c.RejectionReason))
                                {
                                    <div class="small text-danger mt-1" style="max-width: 220px;">
                                        <i class="bi bi-chat-left-dots me-1"></i><strong>Lý do:</strong> @c.RejectionReason
                                    </div>
                                }
                            </td>
                            <td class="text-muted small">
                                @c.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm icon-circle-btn" title="Xem trang khóa học">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Courses" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm icon-circle-btn" title="Chỉnh sửa thông tin khóa học">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Curriculum" asp-route-id="@c.Id" class="btn btn-soft-brand btn-sm icon-circle-btn" title="Quản lý giáo trình và bài giảng">
                                        <i class="bi bi-collection-play"></i>
                                    </a>
                                    @if (!isAdmin)
                                    {
                                        <a asp-controller="InstructorStudents" asp-action="Index" asp-route-courseId="@c.Id" class="btn btn-outline-secondary btn-sm icon-circle-btn" title="Danh sách học viên">
                                            <i class="bi bi-people"></i>
                                        </a>
                                    }
                                    <a asp-controller="QuestionBank" asp-action="Index" asp-route-courseId="@c.Id" class="btn btn-outline-secondary btn-sm icon-circle-btn" title="Ngân hàng câu hỏi">
                                        <i class="bi bi-patch-question"></i>
                                    </a>
                                    <a asp-controller="Quiz" asp-action="Index" asp-route-courseId="@c.Id" class="btn btn-outline-brand btn-sm icon-circle-btn" title="Đề thi và khảo thí CAT">
                                        <i class="bi bi-journal-check"></i>
                                    </a>

                                    <span class="vr mx-1 opacity-25"></span>

                                    @if (!c.IsPublished && effectiveStatus is CourseStatus.Draft or CourseStatus.Rejected)
                                    {
                                        <form asp-action="SubmitApproval" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm icon-circle-btn" title="Gửi yêu cầu phê duyệt" onclick="return confirm('Gửi khóa học này để Quản trị viên kiểm duyệt?');">
                                                <i class="bi bi-send-check"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (effectiveStatus == CourseStatus.Approved && c.IsPublished)
                                    {
                                        <form asp-action="Archive" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm icon-circle-btn" title="Lưu trữ / tạm ẩn khóa học" onclick="return confirm('Lưu trữ / tạm ẩn khóa học này? Học viên đã ghi danh vẫn tiếp tục học bình thường.');">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (effectiveStatus == CourseStatus.Archived && !c.IsPublished)
                                    {
                                        @if (c.Lessons != null && c.Lessons.Count > 0)
                                        {
                                            <form asp-action="Unarchive" asp-route-id="@c.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-soft-brand btn-sm icon-circle-btn" title="Gửi yêu cầu mở bán lại" onclick="return confirm('Khóa học sẽ chuyển về trạng thái Chờ duyệt trước khi mở bán lại. Tiếp tục?');">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm icon-circle-btn" disabled title="Cần ít nhất 1 bài giảng trước khi gửi yêu cầu mở bán lại">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    }

                                    @if (c.IsPublished)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm icon-circle-btn" disabled title="Khóa học đang mở bán, cần Lưu trữ hoặc chờ Quản trị viên ẩn trước khi xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else if (enrollmentCount > 0)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm icon-circle-btn" disabled title="Khóa học đã có @enrollmentCount học viên ghi danh nên không thể xóa, chỉ có thể Lưu trữ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-controller="Courses" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa khóa học này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm icon-circle-btn" title="Xóa khóa học">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="liveSearchNoResultRow" style="display: none;">
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-2 d-block mb-2 text-secondary"></i>
                            <span>Không tìm thấy khóa học nào phù hợp với từ khóa của bạn.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Summary & Popular Courses (Below Management Table) -->
@if (!isAdmin && ViewData["EnrollmentSummary"] is InstructorEnrollmentSummary enrollmentSummary)
{
    <partial name="_EnrollmentSummary" model="enrollmentSummary" />
}
@if (!isAdmin && ViewData["PopularCourses"] is IReadOnlyList<InstructorPopularCourse> popularCourses)
{
    <partial name="_PopularCourses" model="popularCourses" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("instructorCourseSearch");
            if (!searchInput) return;

            if (searchInput.value) {
                searchInput.focus();
                const valLen = searchInput.value.length;
                searchInput.setSelectionRange(valLen, valLen);
            }

            let debounceTimer;

            searchInput.addEventListener("input", function () {
                const query = this.value.trim().toLowerCase();
                const rows = document.querySelectorAll(".course-row");
                let matchCount = 0;

                rows.forEach(function (row) {
                    const title = (row.getAttribute("data-title") || "").toLowerCase();
                    const desc = (row.getAttribute("data-desc") || "").toLowerCase();
                    const isMatch = !query || title.includes(query) || desc.includes(query);
                    row.style.display = isMatch ? "" : "none";
                    if (isMatch) matchCount++;
                });

                const badge = document.getElementById("courseCountBadge");
                if (badge) {
                    badge.textContent = matchCount + " khóa học";
                }

                const noResultRow = document.getElementById("liveSearchNoResultRow");
                if (noResultRow) {
                    noResultRow.style.display = (rows.length > 0 && matchCount === 0) ? "" : "none";
                }

                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    searchInput.form.submit();
                }, 600);
            });
        });
    </script>
}
