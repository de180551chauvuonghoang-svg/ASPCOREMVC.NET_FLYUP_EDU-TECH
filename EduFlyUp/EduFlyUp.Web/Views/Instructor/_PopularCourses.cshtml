@model IReadOnlyList<EduFlyUp.BusinessObjects.InstructorPopularCourse>
<section class="card card-modern border-0 shadow-sm mb-5 overflow-hidden rounded-4" id="popular-courses" aria-labelledby="popularCoursesTitle">
    <div class="p-3 p-md-4 border-bottom bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="h5 fw-bold mb-1 d-flex align-items-center gap-2" id="popularCoursesTitle">
                <i class="bi bi-trophy-fill text-warning"></i>
                <span>Khóa học đông học viên</span>
            </h2>
            <p class="text-muted small mb-0">Top 5 khóa học có nhiều học viên đang theo học hoặc đã hoàn thành nhất.</p>
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted p-4 mb-0 small">Chưa có khóa học với học viên đang học hoặc đã hoàn thành.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th scope="col" class="ps-4">Thứ tự</th>
                        <th scope="col">Khóa học</th>
                        <th scope="col" class="text-end">Học viên</th>
                        <th scope="col" class="text-end pe-4">Danh sách ghi danh</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var course = Model[i];
                    <tr data-popular-course-id="@course.Id">
                        <td class="ps-4 fw-semibold text-muted">#@(i + 1)</td>
                        <th scope="row" class="fw-semibold text-dark">@course.Title</th>
                        <td class="text-end fw-bold text-primary">@course.StudentCount</td>
                        <td class="text-end pe-4">
                            <a asp-controller="InstructorStudents" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-brand rounded-pill px-3" aria-label="Xem ghi danh của @course.Title">Xem ghi danh</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
