@{
    ViewData["Title"] = "Trang Chủ - Nền Tảng Học Lập Trình EduFlyUp";
}

<!-- Hero Banner Section 3D -->
<section class="py-4 py-lg-5 position-relative overflow-hidden">
    <div class="row align-items-center">
        <!-- Left Column: Content -->
        <div class="col-lg-7 text-start">
            <div class="hero-badge">
                <span class="hero-badge-pulse"></span>
                <span>✨ Nền Tảng Đào Tạo Chuẩn Doanh Nghiệp .NET 8</span>
            </div>
            
            <h1 class="display-4 fw-extrabold mb-3 lh-sm">
                Nâng Tầm Kỹ Năng Kỹ Sư Phần Mềm Với <span class="text-gradient">EduFlyUp</span>
            </h1>
            
            <p class="lead text-muted mb-4 fs-5 pe-lg-3">
                Chinh phục <strong>Clean Architecture</strong>, ASP.NET Core 8, Entity Framework Core và kiến trúc hệ thống hiện đại từ nền tảng vững chắc đến dự án thực chiến chuẩn quốc tế.
            </p>
            
            <div class="d-flex flex-wrap gap-3 mb-4">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-brand btn-lg rounded-pill px-4 py-3 shadow-lg d-flex align-items-center gap-2">
                    <span>Khám phá khóa học</span>
                    <i class="bi bi-arrow-right fs-5"></i>
                </a>
                <a asp-controller="Courses" asp-action="Create" class="btn btn-outline-brand btn-lg rounded-pill px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill text-primary"></i>
                    <span>Tạo khóa học mới</span>
                </a>
            </div>

            <!-- Tech Stack Badges -->
            <div class="d-flex flex-wrap align-items-center gap-2 pt-2">
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-code-slash me-1 text-primary"></i> C# 12 & .NET 8
                </span>
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-diagram-3-fill me-1 text-success"></i> Clean Architecture
                </span>
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-database-fill-check me-1 text-info"></i> SQL Server & EF Core
                </span>
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Identity & JWT
                </span>
                <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
                    <i class="bi bi-box-seam me-1 text-danger"></i> Docker & CI/CD
                </span>
            </div>
        </div>

        <!-- Right Column: Interactive 3D Canvas -->
        <div class="col-lg-5 position-relative text-center mt-5 mt-lg-0">
            <div id="hero-3d-canvas-container" class="position-relative mx-auto" style="width: 100%; max-width: 460px; height: 440px;">
                <!-- 3D Canvas element -->
                <canvas id="hero-3d-canvas" style="width: 100%; height: 100%; outline: none; cursor: grab;"></canvas>
                
                <!-- Floating Holographic 3D Badges -->
                <div class="badge-3d-floating badge-top-left">
                    <i class="bi bi-layers-half text-primary me-1"></i>
                    <span>Clean Architecture .NET 8</span>
                </div>
                <div class="badge-3d-floating badge-top-right">
                    <i class="bi bi-cpu-fill text-warning me-1"></i>
                    <span>CQRS & MediatR</span>
                </div>
                <div class="badge-3d-floating badge-bottom-right">
                    <i class="bi bi-lightning-charge-fill text-success me-1"></i>
                    <span>Tối ưu độ trễ &lt; 1ms</span>
                </div>
            </div>
            <div class="small text-muted text-center mt-1" style="font-size: 0.75rem;">
                <i class="bi bi-cursor-fill me-1 text-primary"></i>Rê chuột hoặc xoay không gian 3D tương tác
            </div>
        </div>
    </div>
</section>

<!-- Stats Metrics Bar -->
<section class="pb-5 pt-3">
    <div class="row g-3 g-md-4">
        <div class="col-6 col-lg-3">
            <div class="stat-box" data-tilt data-tilt-max="10" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.15">
                <div class="stat-number text-primary">20+</div>
                <div class="text-muted small fw-semibold">Khóa học chuyên sâu</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-box" data-tilt data-tilt-max="10" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.15">
                <div class="stat-number text-success">5,000+</div>
                <div class="text-muted small fw-semibold">Học viên tin tưởng</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-box" data-tilt data-tilt-max="10" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.15">
                <div class="stat-number text-warning">99.4%</div>
                <div class="text-muted small fw-semibold">Đánh giá hài lòng</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-box" data-tilt data-tilt-max="10" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.15">
                <div class="stat-number text-info">100%</div>
                <div class="text-muted small fw-semibold">Dự án mã nguồn mở</div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us / Features Grid (With 3D Parallax Tilt) -->
<section class="py-5">
    <div class="text-center mb-5">
        <span class="text-primary fw-bold text-uppercase small tracking-wide">Tại sao chọn EduFlyUp</span>
        <h2 class="fw-bold mt-1">Học Đúng Lộ Trình - Vững Vàng Nghề Nghiệp</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">Các khóa học tại EduFlyUp được đúc kết từ kinh nghiệm thực chiến tại các tập đoàn công nghệ lớn.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card-feature" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.2">
                <div class="feature-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-layers-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Clean Architecture</h5>
                <p class="text-muted small mb-0">
                    Phân tách triệt để Domain, Application, Infrastructure và Web Presentation theo chuẩn thiết kế quốc tế.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card-feature" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.2">
                <div class="feature-icon-box bg-success-subtle text-success">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Tối Ưu Hiệu Năng</h5>
                <p class="text-muted small mb-0">
                    Thành thạo tối ưu câu truy vấn EF Core, caching với Redis, AsNoTracking và phân trang thông minh.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card-feature" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.2">
                <div class="feature-icon-box bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="fw-bold mb-2">Bảo Mật Đa Tầng</h5>
                <p class="text-muted small mb-0">
                    Tích hợp ASP.NET Core Identity, Cookie Authentication cho MVC, JWT Token cho Web API & phân quyền Role-based.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card-feature" data-tilt data-tilt-max="12" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.2">
                <div class="feature-icon-box bg-info-subtle text-info">
                    <i class="bi bi-award-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Sẵn Sàng Làm Việc</h5>
                <p class="text-muted small mb-0">
                    Tạo lập portfolio ấn tượng với dự án thật, hỗ trợ mentor giải đáp thắc mắc và định hướng phỏng vấn tuyển dụng.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="my-5">
    <div class="p-5 rounded-4 text-white position-relative overflow-hidden shadow-lg" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #31104b 100%);">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">🚀 Sẵn sàng thăng tiến</span>
                <h2 class="display-6 fw-bold text-white mb-3">Bắt đầu khóa học .NET đầu tiên của bạn ngay hôm nay!</h2>
                <p class="text-light opacity-75 mb-4 pe-lg-4">
                    Đăng ký tài khoản miễn phí để truy cập toàn bộ tài liệu giáo trình và tham gia cộng đồng lập trình viên nhiệt huyết.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-brand rounded-pill px-4 py-2">
                        <i class="bi bi-person-plus-fill me-1"></i>Đăng ký miễn phí
                    </a>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2">
                        <i class="bi bi-compass me-1"></i>Xem tất cả khóa học
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="p-4 rounded-4" style="background: rgba(255, 255, 255, 0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <i class="bi bi-mortarboard-fill text-warning display-4 mb-2 d-inline-block"></i>
                    <h5 class="fw-bold text-white mb-1">Cam kết chất lượng</h5>
                    <p class="small text-light opacity-75 mb-0">Giáo trình cập nhật liên tục theo phiên bản .NET mới nhất từ Microsoft.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script>
        (function () {
            const canvas = document.getElementById("hero-3d-canvas");
            const container = document.getElementById("hero-3d-canvas-container");
            if (!canvas || !container || typeof THREE === "undefined") return;

            // 1. Scene setup
            const scene = new THREE.Scene();
            const width = container.clientWidth || 400;
            const height = container.clientHeight || 400;

            const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.z = 7.5;

            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                alpha: true,
                antialias: true
            });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // 2. Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            scene.add(ambientLight);

            const pointLightPurple = new THREE.PointLight(0x8b5cf6, 3, 50);
            pointLightPurple.position.set(5, 5, 5);
            scene.add(pointLightPurple);

            const pointLightCyan = new THREE.PointLight(0x06b6d4, 3, 50);
            pointLightCyan.position.set(-5, -5, 5);
            scene.add(pointLightCyan);

            // 3. Central 3D Geometric Group (Clean Architecture Core)
            const coreGroup = new THREE.Group();
            scene.add(coreGroup);

            // 3.1 Outer Geometric Wireframe (Icosahedron / Torus Knot)
            const outerGeometry = new THREE.IcosahedronGeometry(2.2, 2);
            const outerMaterial = new THREE.MeshStandardMaterial({
                color: 0x6366f1,
                wireframe: true,
                transparent: true,
                opacity: 0.35,
                roughness: 0.2,
                metalness: 0.8
            });
            const outerMesh = new THREE.Mesh(outerGeometry, outerMaterial);
            coreGroup.add(outerMesh);

            // 3.2 Inner Glowing Solid Core Sphere
            const innerGeometry = new THREE.SphereGeometry(1.2, 32, 32);
            const innerMaterial = new THREE.MeshPhongMaterial({
                color: 0x4f46e5,
                emissive: 0x312e81,
                shininess: 90,
                transparent: true,
                opacity: 0.85
            });
            const innerMesh = new THREE.Mesh(innerGeometry, innerMaterial);
            coreGroup.add(innerMesh);

            // 3.3 Orbiting Ring
            const ringGeometry = new THREE.TorusGeometry(3.2, 0.04, 16, 100);
            const ringMaterial = new THREE.MeshBasicMaterial({
                color: 0x818cf8,
                transparent: true,
                opacity: 0.6
            });
            const ringMesh = new THREE.Mesh(ringGeometry, ringMaterial);
            ringMesh.rotation.x = Math.PI / 3;
            coreGroup.add(ringMesh);

            // 3.4 Second Orbiting Ring
            const ringGeometry2 = new THREE.TorusGeometry(2.8, 0.03, 16, 100);
            const ringMaterial2 = new THREE.MeshBasicMaterial({
                color: 0x06b6d4,
                transparent: true,
                opacity: 0.5
            });
            const ringMesh2 = new THREE.Mesh(ringGeometry2, ringMaterial2);
            ringMesh2.rotation.x = -Math.PI / 4;
            ringMesh2.rotation.y = Math.PI / 6;
            coreGroup.add(ringMesh2);

            // 3.5 Floating Star Particles
            const particlesCount = 280;
            const positions = new Float32Array(particlesCount * 3);
            for (let i = 0; i < particlesCount * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 10;
                positions[i + 1] = (Math.random() - 0.5) * 10;
                positions[i + 2] = (Math.random() - 0.5) * 10;
            }
            const particlesGeometry = new THREE.BufferGeometry();
            particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const particlesMaterial = new THREE.PointsMaterial({
                size: 0.05,
                color: 0xa5b4fc,
                transparent: true,
                opacity: 0.8
            });
            const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
            scene.add(particlesMesh);

            // 4. Interactive Mouse Tracking
            let mouseX = 0;
            let mouseY = 0;
            let targetX = 0;
            let targetY = 0;

            const windowHalfX = window.innerWidth / 2;
            const windowHalfY = window.innerHeight / 2;

            function onMouseMove(event) {
                mouseX = (event.clientX - windowHalfX) * 0.0008;
                mouseY = (event.clientY - windowHalfY) * 0.0008;
            }
            window.addEventListener('mousemove', onMouseMove, { passive: true });

            // 5. Animation Loop
            let clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);

                const elapsedTime = clock.getElapsedTime();

                // Smooth rotation
                coreGroup.rotation.y += 0.005;
                coreGroup.rotation.x += 0.003;
                ringMesh.rotation.z += 0.008;
                ringMesh2.rotation.z -= 0.006;
                particlesMesh.rotation.y -= 0.001;

                // Subtle levitation
                coreGroup.position.y = Math.sin(elapsedTime * 1.5) * 0.15;

                // Easing mouse parallax
                targetX += (mouseX - targetX) * 0.05;
                targetY += (mouseY - targetY) * 0.05;

                coreGroup.rotation.y += targetX * 0.5;
                coreGroup.rotation.x += targetY * 0.5;

                renderer.render(scene, camera);
            }
            animate();

            // 6. Handle Responsive Resize
            function onResize() {
                const newWidth = container.clientWidth;
                const newHeight = container.clientHeight;
                if (newWidth && newHeight) {
                    camera.aspect = newWidth / newHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(newWidth, newHeight);
                }
            }
            window.addEventListener('resize', onResize);
        })();
    </script>
}
