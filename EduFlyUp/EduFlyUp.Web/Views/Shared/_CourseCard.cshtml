@model EduFlyUp.Web.Models.Courses.CourseItemModel

<div class="course-card">
    <div class="course-thumbnail-wrapper">
        <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : Model.ThumbnailUrl)" 
             class="course-thumbnail" 
             alt="@Model.Title"
             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';" />
        
        <!-- Level Badge Floating on Image -->
        @if (Model.Level.ToString() == "Beginner" || Model.Level.ToString() == "Cơ bản")
        {
            <span class="course-level-pill badge-beginner">
                <i class="bi bi-star-fill me-1"></i>Cơ bản
            </span>
        }
        else if (Model.Level.ToString() == "Intermediate" || Model.Level.ToString() == "Trung bình")
        {
            <span class="course-level-pill badge-intermediate">
                <i class="bi bi-lightning-charge-fill me-1"></i>Trung bình
            </span>
        }
        else
        {
            <span class="course-level-pill badge-advanced">
                <i class="bi bi-fire me-1"></i>Nâng cao
            </span>
        }
    </div>

    <div class="p-4 d-flex flex-column flex-grow-1">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted small d-flex align-items-center gap-1">
                <i class="bi bi-play-circle-fill text-primary"></i>
                <span class="fw-semibold">@Model.LessonCount</span> bài học
            </span>
            <span class="badge bg-light text-secondary border small">
                <i class="bi bi-check2-circle text-success me-1"></i>Chứng chỉ
            </span>
        </div>

        <h5 class="fw-bold mb-2 text-dark" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3rem; line-height: 1.4;">
            @Model.Title
        </h5>

        <p class="text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            @Model.Description
        </p>

        <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto">
            <div>
                @if (Model.IsFree)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill fw-bold">
                        Miễn phí
                    </span>
                }
                else
                {
                    <div class="small text-muted" style="font-size: 0.75rem; line-height: 1;">Học phí trọn gói</div>
                    <span class="fw-extrabold text-primary fs-5">
                        @Model.Price.ToString("N0") <span class="small fs-6 text-muted fw-normal">đ</span>
                    </span>
                }
            </div>

            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-brand rounded-pill px-3 py-2 btn-sm d-flex align-items-center gap-1">
                <span>Chi tiết</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
