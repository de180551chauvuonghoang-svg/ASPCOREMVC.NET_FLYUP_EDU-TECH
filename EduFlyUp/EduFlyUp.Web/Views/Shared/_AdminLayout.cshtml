@using Microsoft.AspNetCore.Identity
@inject SignInManager<EduFlyUp.BusinessObjects.ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduFlyUp Management Portal</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-backdrop" id="adminBackdrop"></div>

    <div class="admin-wrapper">
        <!-- 1. MODERN DARK SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Sidebar Header Brand -->
            <div class="admin-sidebar-brand d-flex align-items-center justify-content-between">
                <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                    <span class="fw-black fs-3 text-white tracking-wider" style="letter-spacing: 1.5px; font-weight: 900;">
                        FLY<span style="color: #818cf8;">UP</span>
                    </span>
                    <span class="badge bg-primary bg-opacity-25 text-primary-light border border-primary border-opacity-25 rounded-pill px-2 py-1 small" style="font-size: 0.65rem;">
                        PORTAL
                    </span>
                </a>
                <button type="button" class="btn btn-link text-muted d-lg-none p-0" id="sidebarCloseBtn">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            <!-- Current User Badge Card in Sidebar -->
            <div class="admin-user-card">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px; font-size: 1rem; flex-shrink: 0;">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="overflow-hidden">
                    <div class="text-white fw-bold text-truncate" style="font-size: 0.88rem;">@User.Identity?.Name</div>
                    <div class="mt-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 rounded-pill px-2 py-0" style="font-size: 0.68rem;">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản Trị Viên
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2 py-0" style="font-size: 0.68rem;">
                                <i class="bi bi-mortarboard-fill me-1"></i>Giảng Viên
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Navigation Sections -->
            <div class="flex-grow-1 overflow-y-auto py-2">
                <!-- Section 1: Dashboard Hubs -->
                <div class="admin-nav-section">Bảng Điều Khiển</div>
                
                @if (User.IsInRole("Admin"))
                {
                    <div class="admin-nav-item">
                        <a asp-area="" asp-controller="Admin" asp-action="Index" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Admin Hub (Hệ Thống)</span>
                        </a>
                    </div>
                }

                <div class="admin-nav-item">
                    <a asp-area="" asp-controller="Instructor" asp-action="Dashboard" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Instructor" ? "active" : "")">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span>Kênh Giảng Viên (Studio)</span>
                    </a>
                </div>

                <!-- Section 2: Course Management -->
                <div class="admin-nav-section mt-3">Quản Lý Đào Tạo</div>

                <div class="admin-nav-item">
                    <a asp-area="" asp-controller="Courses" asp-action="Create" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Tạo khóa học mới</span>
                    </a>
                </div>

                <div class="admin-nav-item">
                    <a asp-area="" asp-controller="Courses" asp-action="Index" class="admin-nav-link">
                        <i class="bi bi-collection-play"></i>
                        <span>Xem trang khóa học</span>
                    </a>
                </div>

                <!-- Section 3: Navigation & System -->
                <div class="admin-nav-section mt-3">Điều Hướng & Hệ Thống</div>

                <div class="admin-nav-item">
                    <a href="/" class="admin-nav-link">
                        <i class="bi bi-house-door"></i>
                        <span>Về trang chủ Web</span>
                    </a>
                </div>

                <div class="admin-nav-item">
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="adminLogoutForm" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="admin-nav-link w-100 border-0 bg-transparent text-start">
                            <i class="bi bi-box-arrow-right text-danger"></i>
                            <span class="text-danger">Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Sidebar Footer Status -->
            <div class="p-3 border-top border-white border-opacity-10 text-muted small d-flex align-items-center justify-content-between" style="font-size: 0.75rem;">
                <span class="d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-success d-inline-block" style="width: 8px; height: 8px;"></span>
                    Online • Trực tuyến
                </span>
                <span class="opacity-75">v2.0 Clean Arch</span>
            </div>
        </aside>

        <!-- 2. MAIN VIEWPORT -->
        <div class="admin-main">
            <!-- Topbar Header -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle d-lg-none" id="sidebarToggleBtn">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-none d-sm-block">
                        <div class="text-muted small fw-semibold">
                            <i class="bi bi-folder2-open me-1"></i>EduFlyUp Management Portal
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 d-none d-md-inline-flex align-items-center gap-1" title="Xem trang người học">
                        <i class="bi bi-globe"></i>
                        <span>Xem Website</span>
                    </a>

                    <a asp-area="" asp-controller="Courses" asp-action="Create" class="btn btn-brand btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1 shadow-glow">
                        <i class="bi bi-plus-lg"></i>
                        <span>Tạo khóa học</span>
                    </a>

                    <!-- User Dropdown in Topbar -->
                    <div class="dropdown">
                        <button class="btn btn-light rounded-pill p-1 ps-2 pe-3 d-flex align-items-center gap-2 border shadow-xs" type="button" data-bs-toggle="dropdown">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="small fw-semibold text-dark d-none d-sm-inline">@User.Identity?.Name</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2">
                            <li class="px-3 py-2 border-bottom mb-2">
                                <div class="small fw-bold text-dark">@User.Identity?.Name</div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @(User.IsInRole("Admin") ? "Vai trò: Quản trị viên" : "Vai trò: Giảng viên")
                                </div>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2 text-warning"></i>Admin Hub
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item rounded-3 py-2" asp-area="" asp-controller="Instructor" asp-action="Dashboard">
                                    <i class="bi bi-mortarboard-fill me-2 text-success"></i>Kênh Giảng Viên
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2" asp-area="" asp-controller="Courses" asp-action="Index">
                                    <i class="bi bi-collection-play me-2 text-primary"></i>Danh mục khóa học
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item rounded-3 py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Workspace Container -->
            <main class="admin-content p-3 p-md-4 p-lg-5">
                <!-- Flash Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto shadow-none" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-3"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto shadow-none" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Minimal Admin Footer -->
            <footer class="admin-footer py-3 px-4 d-flex flex-wrap justify-content-between align-items-center text-muted">
                <div>
                    © 2026 <strong>EduFlyUp Portal</strong> — Nền tảng học tập & đào tạo công nghệ cao.
                </div>
                <div class="d-flex gap-3 small">
                    <a href="/" class="text-decoration-none text-muted hover-primary">Trang chủ</a>
                    <span>•</span>
                    <a href="/Courses" class="text-decoration-none text-muted hover-primary">Khóa học</a>
                    <span>•</span>
                    <span class="text-success"><i class="bi bi-shield-check me-1"></i>Bảo mật Identity & Role-Based</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("adminSidebar");
            const toggleBtn = document.getElementById("sidebarToggleBtn");
            const closeBtn = document.getElementById("sidebarCloseBtn");
            const backdrop = document.getElementById("adminBackdrop");

            function toggleSidebar() {
                if (sidebar) sidebar.classList.toggle("show");
                if (backdrop) backdrop.classList.toggle("show");
            }

            if (toggleBtn) toggleBtn.addEventListener("click", toggleSidebar);
            if (closeBtn) closeBtn.addEventListener("click", toggleSidebar);
            if (backdrop) backdrop.addEventListener("click", toggleSidebar);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
