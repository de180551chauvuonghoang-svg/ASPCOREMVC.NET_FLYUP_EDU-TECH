@model EduFlyUp.Web.Models.Courses.MyCoursesPageViewModel

@{
    ViewData["Title"] = "Góc học tập & Chứng chỉ của tôi - EduFlyUp";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Index" class="text-muted text-decoration-none">Khóa học</a></li>
            <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Góc học tập cá nhân</li>
        </ol>
    </nav>

    <!-- Celebration Alert if redirected after payment -->
    @if (Context.Request.Query.ContainsKey("enrolled"))
    {
        <div class="alert border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3 animate__animated animate__fadeIn" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-left: 5px solid #10b981 !important;">
            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 54px; height: 54px; background: #10b981; color: #ffffff;">
                <i class="bi bi-patch-check-fill fs-3"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1" style="color: #065f46;">Thanh toán & Ghi danh thành công!</h5>
                <p class="mb-0 small" style="color: #047857;">Khóa học của bạn đã được kích hoạt trọn đời. Hãy bấm <strong>Vào học ngay</strong> trên thẻ khóa học bên dưới để bắt đầu bài giảng.</p>
            </div>
        </div>
    }

    <!-- Premium Hero Banner -->
    <div class="rounded-4 p-4 p-md-5 mb-5 position-relative overflow-hidden shadow-lg" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #312e81 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Ambient Glow -->
        <div class="position-absolute top-0 end-0 rounded-circle" style="width: 320px; height: 320px; background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, rgba(99, 102, 241, 0) 70%); filter: blur(40px); pointer-events: none;"></div>
        
        <!-- Watermark Icon -->
        <div class="position-absolute end-0 top-50 translate-middle-y pe-4 pe-lg-5 d-none d-md-block" style="opacity: 0.12; color: #ffffff; pointer-events: none;">
            <i class="bi bi-award" style="font-size: 11rem; line-height: 1;"></i>
        </div>

        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-7">
                <!-- Tag pill -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill mb-3 shadow-sm" 
                     style="background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); font-size: 0.85rem; font-weight: 500;">
                    <i class="bi bi-mortarboard-fill text-warning"></i>
                    <span>Không gian học tập & Chứng chỉ cá nhân</span>
                </div>

                <h1 class="display-6 fw-extrabold mb-2" style="color: #ffffff !important; letter-spacing: -0.02em;">
                    Khóa học & Chứng chỉ của tôi
                </h1>
                
                <p class="mb-0 fs-6" style="color: #cbd5e1 !important; max-width: 620px; line-height: 1.6;">
                    Theo dõi tiến độ, hoàn thành &ge; 95% bài học và vượt qua kỳ thi tốt nghiệp (Final Test &ge; 95%) để nhận Chứng chỉ chính thức. Các khóa học đã tốt nghiệp được lưu trữ riêng để bạn có thể học lại bất cứ lúc nào!
                </p>
            </div>

            <div class="col-lg-5 text-lg-end mt-4 mt-lg-0">
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="p-3 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);">
                            <div class="fs-4 fw-extrabold text-info mb-0">@Model.InProgressCount</div>
                            <span class="small" style="color: #94a3b8; font-size: 0.75rem;">Đang học</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);">
                            <div class="fs-4 fw-extrabold text-success mb-0">@Model.CompletedCount</div>
                            <span class="small" style="color: #94a3b8; font-size: 0.75rem;">Đã hoàn thành</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);">
                            <div class="fs-4 fw-extrabold text-warning mb-0">@Model.TotalCertificatesCount</div>
                            <span class="small" style="color: #94a3b8; font-size: 0.75rem;">Chứng chỉ đạt</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Tabs: In-Progress vs Completed vs Certificates -->
    <ul class="nav nav-pills gap-2 p-1.5 mb-4 rounded-4 shadow-sm" id="myAcademyTabs" role="tablist" style="background: #ffffff; border: 1px solid #e2e8f0; max-width: 680px;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold py-2.5 px-3 d-flex align-items-center gap-2" 
                    id="tab-inprogress" data-bs-toggle="pill" data-bs-target="#content-inprogress" type="button" role="tab">
                <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                <span>Đang học (@Model.InProgressCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold py-2.5 px-3 d-flex align-items-center gap-2" 
                    id="tab-completed" data-bs-toggle="pill" data-bs-target="#content-completed" type="button" role="tab">
                <i class="bi bi-patch-check-fill text-success fs-5"></i>
                <span>Đã hoàn thành (@Model.CompletedCount)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold py-2.5 px-3 d-flex align-items-center gap-2" 
                    id="tab-certificates" data-bs-toggle="pill" data-bs-target="#content-certificates" type="button" role="tab">
                <i class="bi bi-award-fill text-warning fs-5"></i>
                <span>Chứng chỉ của tôi (@Model.TotalCertificatesCount)</span>
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="myAcademyTabContent">
        
        <!-- ================= TAB 1: KHÓA HỌC ĐANG HỌC ================= -->
        <div class="tab-pane fade show active" id="content-inprogress" role="tabpanel">
            @if (!Model.InProgressCourses.Any())
            {
                <!-- Empty State -->
                <div class="card card-modern border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background: #ffffff;">
                    <div class="py-5">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 shadow-sm" 
                             style="width: 80px; height: 80px; background: #ecfdf5; color: #10b981;">
                            <i class="bi bi-check2-circle fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-2 text-dark">Bạn không có khóa học nào đang học dở</h4>
                        <p class="mx-auto mb-4 small text-muted" style="max-width: 500px;">
                            Tất cả các khóa học bạn đã đăng ký đều đã được hoàn thành xuất sắc hoặc bạn chưa đăng ký khóa học mới nào.
                        </p>
                        <div class="d-flex justify-content-center gap-2">
                            @if (Model.CompletedCount > 0)
                            {
                                <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2.5 fw-semibold" onclick="document.getElementById('tab-completed').click();">
                                    <i class="bi bi-patch-check me-1"></i>Xem khóa học đã hoàn thành (@Model.CompletedCount)
                                </button>
                            }
                            <a asp-controller="Courses" asp-action="Index" class="btn btn-brand rounded-pill px-4 py-2.5 fw-semibold shadow-glow">
                                <i class="bi bi-compass me-1"></i>Khám phá khóa học mới
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- In-Progress Cards Grid -->
                <div class="row g-4 mb-5">
                    @foreach (var item in Model.InProgressCourses)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-modern h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column" 
                                 style="background: #ffffff; border: 1px solid #f1f5f9 !important; transition: all 0.3s ease;">
                                
                                <div class="position-relative overflow-hidden" style="height: 190px;">
                                    <img src="@item.ThumbnailUrl" class="w-100 h-100 object-fit-cover" alt="@item.CourseTitle" 
                                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';" />
                                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(15, 23, 42, 0.2) 0%, rgba(15, 23, 42, 0.7) 100%);"></div>

                                    <span class="badge position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill small fw-semibold shadow-sm d-inline-flex align-items-center gap-1.5"
                                          style="background: #6366f1; color: #ffffff; font-size: 0.75rem;">
                                        <i class="bi bi-play-circle-fill"></i>
                                        <span>ĐANG HỌC</span>
                                    </span>

                                    <span class="position-absolute bottom-0 end-0 m-3 px-2.5 py-1 rounded-pill small fw-semibold d-inline-flex align-items-center gap-1"
                                          style="background: rgba(15, 23, 42, 0.85); color: #f8fafc; font-size: 0.75rem; backdrop-filter: blur(4px);">
                                        <i class="bi bi-journal-code text-primary"></i>
                                        <span>@item.LessonCount bài học</span>
                                    </span>
                                </div>

                                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                                    <div class="small mb-2 d-flex align-items-center gap-2" style="color: #64748b;">
                                        <span><i class="bi bi-calendar3 me-1 text-primary"></i>Kích hoạt: @item.EnrolledAt.ToString("dd/MM/yyyy")</span>
                                        <span>•</span>
                                        <span class="text-success fw-semibold"><i class="bi bi-infinity me-1"></i>Trọn đời</span>
                                    </div>

                                    <h5 class="fw-bold mb-2" style="color: #0f172a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem; line-height: 1.4;">
                                        @item.CourseTitle
                                    </h5>

                                    <p class="small flex-grow-1 mb-4" style="color: #64748b; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "Khóa học chất lượng cao, bài giảng trực quan, mã nguồn chi tiết tại EduFlyUp." : item.Description)
                                    </p>

                                    <!-- Action Buttons -->
                                    <div class="mt-auto pt-3 border-top d-flex gap-2">
                                        @if (item.FirstLessonId.HasValue)
                                        {
                                            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.FirstLessonId.Value" 
                                               class="btn btn-brand flex-grow-1 py-2.5 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2 shadow-glow">
                                                <i class="bi bi-play-circle-fill fs-6"></i>
                                                <span>Vào học ngay</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Lessons" asp-action="Course" asp-route-id="@item.CourseId" 
                                               class="btn btn-brand flex-grow-1 py-2.5 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2 shadow-glow">
                                                <i class="bi bi-play-circle-fill fs-6"></i>
                                                <span>Vào học ngay</span>
                                            </a>
                                        }

                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" 
                                           class="btn btn-outline-secondary rounded-pill py-2.5 px-3 btn-sm d-flex align-items-center justify-content-center" 
                                           title="Xem thông tin chi tiết">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= TAB 2: KHÓA HỌC ĐÃ HOÀN THÀNH ================= -->
        <div class="tab-pane fade" id="content-completed" role="tabpanel">
            @if (!Model.CompletedCourses.Any())
            {
                <div class="card card-modern border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background: #ffffff;">
                    <div class="py-5">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 shadow-sm" 
                             style="width: 80px; height: 80px; background: #fef9c3; color: #ca8a04;">
                            <i class="bi bi-mortarboard fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-2 text-dark">Bạn chưa hoàn thành khóa học nào</h4>
                        <p class="mx-auto mb-4 small text-muted" style="max-width: 520px; line-height: 1.6;">
                            Hoàn thành &ge; 95% số bài học của khóa học và vượt qua bài thi tốt nghiệp Final Test &ge; 95 điểm để nhận Chứng chỉ tốt nghiệp và đưa khóa học vào danh sách này.
                        </p>
                        <button type="button" class="btn btn-brand rounded-pill px-4 py-2.5 fw-semibold shadow-glow" onclick="document.getElementById('tab-inprogress').click();">
                            <i class="bi bi-arrow-left me-1"></i>Xem các khóa học đang học
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4 mb-5">
                    @foreach (var item in Model.CompletedCourses)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-modern h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column" 
                                 style="background: #ffffff; border: 1.5px solid #a7f3d0 !important; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.08) !important;">
                                
                                <div class="position-relative overflow-hidden" style="height: 190px;">
                                    <img src="@item.ThumbnailUrl" class="w-100 h-100 object-fit-cover" alt="@item.CourseTitle" 
                                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';" />
                                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(6, 78, 59, 0.3) 0%, rgba(6, 78, 59, 0.85) 100%);"></div>

                                    <!-- Completed Badge -->
                                    <span class="badge position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill small fw-bold shadow d-inline-flex align-items-center gap-1.5"
                                          style="background: #10b981; color: #ffffff; font-size: 0.78rem; border: 1px solid #ffffff;">
                                        <i class="bi bi-patch-check-fill text-warning"></i>
                                        <span>ĐÃ TỐT NGHIỆP</span>
                                    </span>

                                    <!-- Score badge on image -->
                                    <span class="position-absolute bottom-0 end-0 m-3 px-3 py-1 rounded-pill small fw-bold d-inline-flex align-items-center gap-1 shadow-sm"
                                          style="background: rgba(15, 23, 42, 0.85); color: #facc15; font-size: 0.75rem; backdrop-filter: blur(4px);">
                                        <i class="bi bi-trophy-fill"></i>
                                        <span>@(item.FinalScore.HasValue ? $"{item.FinalScore}% Final Test" : "100% Đạt")</span>
                                    </span>
                                </div>

                                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                                    <div class="small mb-2 d-flex align-items-center justify-content-between" style="color: #64748b;">
                                        <span><i class="bi bi-calendar-check me-1 text-success"></i>Tốt nghiệp: @(item.CompletedAt.HasValue ? item.CompletedAt.Value.ToString("dd/MM/yyyy") : "Đã cấp")</span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">Học lại trọn đời</span>
                                    </div>

                                    <h5 class="fw-bold mb-2" style="color: #0f172a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem; line-height: 1.4;">
                                        @item.CourseTitle
                                    </h5>

                                    <p class="small flex-grow-1 mb-3" style="color: #64748b; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "Khóa học chất lượng cao, bài giảng trực quan, mã nguồn chi tiết tại EduFlyUp." : item.Description)
                                    </p>

                                    <!-- Certificate Notice Box -->
                                    <div class="p-2.5 rounded-3 mb-3 d-flex align-items-center justify-content-between" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                                        <div class="d-flex align-items-center gap-2 small" style="color: #166534; font-size: 0.78rem;">
                                            <i class="bi bi-award-fill text-warning fs-6"></i>
                                            <span>Mã số: <strong>@(item.CertificateCode ?? "Đã cấp chứng chỉ")</strong></span>
                                        </div>
                                        <span class="badge bg-success rounded-pill" style="font-size: 0.68rem;">Đã chứng thực</span>
                                    </div>

                                    <!-- Action Buttons: Học lại vs Xem Chứng Chỉ -->
                                    <div class="mt-auto pt-3 border-top d-flex flex-wrap gap-2">
                                        @if (item.FirstLessonId.HasValue)
                                        {
                                            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.FirstLessonId.Value" 
                                               class="btn btn-outline-brand flex-grow-1 py-2 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-1.5" title="Vào ôn tập và học lại bất cứ lúc nào">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Học lại bài giảng</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Lessons" asp-action="Course" asp-route-id="@item.CourseId" 
                                               class="btn btn-outline-brand flex-grow-1 py-2 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-1.5" title="Vào ôn tập và học lại bất cứ lúc nào">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Học lại bài giảng</span>
                                            </a>
                                        }

                                        @if (item.CertificateId.HasValue)
                                        {
                                            <a asp-controller="Certificate" asp-action="ViewCertificate" asp-route-id="@item.CertificateId.Value" target="_blank" 
                                               class="btn btn-warning py-2 px-3 rounded-pill fw-bold btn-sm text-dark d-flex align-items-center justify-content-center gap-1 shadow-sm">
                                                <i class="bi bi-award-fill"></i>
                                                <span>Chứng chỉ</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= TAB 3: CHỨNG CHỈ CỦA TÔI ================= -->
        <div class="tab-pane fade" id="content-certificates" role="tabpanel">
            @if (!Model.Certificates.Any())
            {
                <!-- Empty State Certificates -->
                <div class="card card-modern border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background: #ffffff;">
                    <div class="py-5">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 shadow-sm" 
                             style="width: 80px; height: 80px; background: linear-gradient(135deg, rgba(234, 179, 8, 0.1) 0%, rgba(202, 138, 4, 0.2) 100%); color: #ca8a04;">
                            <i class="bi bi-award fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-2 text-dark">Bạn chưa đạt được chứng chỉ nào</h4>
                        <p class="mx-auto mb-4 small text-muted" style="max-width: 500px; line-height: 1.6;">
                            Mỗi khóa học sẽ cấp <strong>duy nhất 1 chứng chỉ tốt nghiệp</strong> khi bạn hoàn thành &ge; 95% bài học và đạt &ge; 95% điểm trong bài thi Final Test.
                        </p>
                        <button type="button" class="btn btn-brand rounded-pill px-4 py-2.5 fw-semibold shadow-glow" onclick="document.getElementById('tab-inprogress').click();">
                            <i class="bi bi-mortarboard me-1"></i>Tiếp tục học để nhận chứng chỉ
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Certificates Grid -->
                <div class="row g-4 mb-5">
                    @foreach (var cert in Model.Certificates)
                    {
                        <div class="col-md-6 col-lg-6">
                            <div class="card border-0 rounded-4 p-4 p-md-5 h-100 position-relative overflow-hidden shadow-lg d-flex flex-column" 
                                 style="background: linear-gradient(135deg, #0b0f19 0%, #1e1b4b 60%, #1e1b4b 100%); border: 2px solid #ca8a04 !important; box-shadow: 0 10px 30px rgba(234, 179, 8, 0.15) !important;">
                                
                                <!-- Gold Watermark Seal -->
                                <div class="position-absolute end-0 bottom-0 p-3 opacity-15 pointer-events-none d-none d-sm-block" style="color: #facc15;">
                                    <i class="bi bi-patch-check" style="font-size: 8rem; line-height: 0.8;"></i>
                                </div>

                                <div class="d-flex align-items-center justify-content-between mb-3 position-relative" style="z-index: 2;">
                                    <span class="badge px-3 py-1.5 rounded-pill fw-bold d-inline-flex align-items-center gap-1.5" 
                                          style="background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.4); font-size: 0.8rem;">
                                        <i class="bi bi-patch-check-fill"></i>
                                        CHỨNG CHỈ TỐT NGHIỆP
                                    </span>
                                    <span class="small font-monospace text-slate-300" style="color: #cbd5e1;">
                                        Mã: <strong class="text-white">@cert.CertificateCode</strong>
                                    </span>
                                </div>

                                <h4 class="fw-bold text-white mb-2 position-relative" style="z-index: 2; line-height: 1.4;">
                                    @cert.CourseTitle
                                </h4>

                                <div class="mb-4 position-relative small" style="z-index: 2; color: #cbd5e1;">
                                    <div class="mb-1">Học viên chứng nhận: <strong class="text-white">@cert.StudentName</strong></div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span><i class="bi bi-calendar3 me-1 text-primary"></i>Ngày cấp: @cert.IssuedAt.ToString("dd/MM/yyyy")</span>
                                        <span>•</span>
                                        <span class="text-warning fw-bold"><i class="bi bi-trophy-fill me-1"></i>Điểm Final Test: @cert.FinalScore%</span>
                                    </div>
                                    <div class="mt-1 small" style="color: #94a3b8; font-size: 0.75rem;">
                                        <i class="bi bi-info-circle me-1"></i>Chứng chỉ điện tử được cấp duy nhất 1 lần ở lần đầu tiên hoàn thành khóa học.
                                    </div>
                                </div>

                                <div class="mt-auto pt-3 border-top border-white border-opacity-10 d-flex flex-wrap gap-2 position-relative" style="z-index: 2;">
                                    <a asp-controller="Certificate" asp-action="ViewCertificate" asp-route-id="@cert.Id" target="_blank" 
                                       class="btn btn-warning rounded-pill px-4 py-2 fw-bold btn-sm d-inline-flex align-items-center gap-2 shadow-sm text-dark flex-grow-1 justify-content-center">
                                        <i class="bi bi-eye-fill"></i>
                                        <span>Xem chứng chỉ</span>
                                    </a>

                                    <a asp-controller="Certificate" asp-action="ViewCertificate" asp-route-id="@cert.Id" target="_blank" 
                                       class="btn btn-outline-light rounded-pill px-3 py-2 btn-sm d-inline-flex align-items-center gap-1.5" title="In hoặc lưu file PDF">
                                        <i class="bi bi-printer-fill"></i>
                                        <span>In / Tải PDF</span>
                                    </a>

                                    <a asp-controller="Certificate" asp-action="Verify" asp-route-code="@cert.CertificateCode" target="_blank" 
                                       class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm text-slate-300 border-secondary" title="Xác minh công khai">
                                        <i class="bi bi-shield-check"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>

</div>
