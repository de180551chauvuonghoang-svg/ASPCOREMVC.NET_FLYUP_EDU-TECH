@model List<EduFlyUp.Web.Models.Courses.MyCourseItemModel>

@{
    ViewData["Title"] = "Khóa học của tôi - EduFlyUp";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Index" class="text-muted text-decoration-none">Khóa học</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khóa học của tôi</li>
        </ol>
    </nav>

    <!-- Celebration Alert if redirected after payment -->
    @if (Context.Request.Query.ContainsKey("enrolled"))
    {
        <div class="alert alert-success border-success-subtle shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3 animate__animated animate__fadeIn">
            <div class="bg-success text-white rounded-circle p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px;">
                <i class="bi bi-patch-check-fill fs-3"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1 text-success">Thanh toán & Ghi danh thành công!</h5>
                <p class="mb-0 text-secondary small">Khóa học của bạn đã được kích hoạt trọn đời. Hãy bấm <strong>Vào học ngay</strong> để bắt đầu bài học đầu tiên.</p>
            </div>
        </div>
    }

    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-gradient text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
        <div class="position-relative z-1">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white bg-opacity-20 rounded-pill small mb-3">
                <i class="bi bi-mortarboard-fill"></i>
                <span>Góc học tập cá nhân</span>
            </div>
            <h1 class="display-6 fw-bold mb-2">Khóa học của tôi</h1>
            <p class="mb-0 opacity-75">Quản lý và tiếp tục tiến độ các khóa học công nghệ bạn đã đăng ký tại EduFlyUp.</p>
        </div>
        <div class="position-absolute end-0 top-50 translate-middle-y opacity-10 pe-5 d-none d-md-block">
            <i class="bi bi-journal-code" style="font-size: 10rem;"></i>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
            <div class="my-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-journal-x fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Bạn chưa đăng ký khóa học nào</h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                    Khám phá ngay kho tàng khóa học lập trình .NET 8, Clean Architecture, Web API từ căn bản đến nâng cao để nâng cấp kỹ năng của bạn.
                </p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-brand rounded-pill px-4 py-3 fw-semibold shadow-glow">
                    <i class="bi bi-compass me-2"></i>Khám phá danh sách khóa học
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Stats Bar -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-collection-play-fill text-primary"></i>
                <span>Đang tham gia (@Model.Count khóa học)</span>
            </h5>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-brand rounded-pill btn-sm px-3">
                <i class="bi bi-plus-circle me-1"></i>Đăng ký thêm khóa học
            </a>
        </div>

        <!-- Course Cards Grid -->
        <div class="row g-4 mb-5">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-modern h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column">
                        <div class="position-relative">
                            <img src="@item.ThumbnailUrl" class="card-img-top" alt="@item.CourseTitle" style="height: 190px; object-fit: cover;" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';" />
                            <span class="badge bg-success-subtle text-success border border-success-subtle position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill small fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i>Đã sở hữu
                            </span>
                        </div>

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="text-muted small mb-2 d-flex align-items-center gap-2">
                                <span><i class="bi bi-calendar3 me-1"></i>@item.EnrolledAt.ToString("dd/MM/yyyy")</span>
                                <span>•</span>
                                <span><i class="bi bi-play-circle me-1"></i>@item.LessonCount bài học</span>
                            </div>

                            <h5 class="fw-bold text-dark mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem;">
                                @item.CourseTitle
                            </h5>

                            <p class="text-muted small flex-grow-1 mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>

                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                @if (item.FirstLessonId.HasValue)
                                {
                                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.FirstLessonId.Value" class="btn btn-brand flex-grow-1 py-2 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2 shadow-glow">
                                        <i class="bi bi-play-circle-fill"></i>
                                        <span>Vào học ngay</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-brand flex-grow-1 py-2 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-eye"></i>
                                        <span>Xem khóa học</span>
                                    </a>
                                }

                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-outline-secondary rounded-pill py-2 px-3 btn-sm" title="Xem thông tin chi tiết">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
