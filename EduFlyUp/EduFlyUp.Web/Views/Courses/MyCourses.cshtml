@model List<EduFlyUp.Web.Models.Courses.MyCourseItemModel>

@{
    ViewData["Title"] = "Khóa học của tôi - EduFlyUp";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Index" class="text-muted text-decoration-none">Khóa học</a></li>
            <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Khóa học của tôi</li>
        </ol>
    </nav>

    <!-- Celebration Alert if redirected after payment -->
    @if (Context.Request.Query.ContainsKey("enrolled"))
    {
        <div class="alert border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3 animate__animated animate__fadeIn" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-left: 5px solid #10b981 !important;">
            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 54px; height: 54px; background: #10b981; color: #ffffff;">
                <i class="bi bi-patch-check-fill fs-3"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1" style="color: #065f46;">Thanh toán & Ghi danh thành công!</h5>
                <p class="mb-0 small" style="color: #047857;">Khóa học của bạn đã được kích hoạt trọn đời. Hãy bấm <strong>Vào học ngay</strong> trên thẻ khóa học bên dưới để bắt đầu bài giảng.</p>
            </div>
        </div>
    }

    <!-- Premium Hero Banner (High Contrast Dark Slate / Indigo Theme) -->
    <div class="rounded-4 p-4 p-md-5 mb-5 position-relative overflow-hidden shadow-lg" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #312e81 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Background Ambient Glow -->
        <div class="position-absolute top-0 end-0 rounded-circle" style="width: 320px; height: 320px; background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, rgba(99, 102, 241, 0) 70%); filter: blur(40px); pointer-events: none;"></div>
        
        <!-- Watermark Icon -->
        <div class="position-absolute end-0 top-50 translate-middle-y pe-4 pe-lg-5 d-none d-md-block" style="opacity: 0.12; color: #ffffff; pointer-events: none;">
            <i class="bi bi-journal-code" style="font-size: 11rem; line-height: 1;"></i>
        </div>

        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <!-- Tag pill -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill mb-3 shadow-sm" 
                     style="background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); font-size: 0.85rem; font-weight: 500;">
                    <i class="bi bi-mortarboard-fill text-warning"></i>
                    <span>Góc học tập cá nhân</span>
                </div>

                <h1 class="display-6 fw-extrabold mb-2" style="color: #ffffff !important; letter-spacing: -0.02em;">
                    Khóa học của tôi
                </h1>
                
                <p class="mb-0 fs-6" style="color: #cbd5e1 !important; max-width: 620px; line-height: 1.6;">
                    Quản lý toàn bộ các khóa học công nghệ bạn đã sở hữu trọn đời. Tiếp tục theo dõi bài giảng, thực hành code và nâng cấp kỹ năng mỗi ngày.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-flex flex-column align-items-lg-end">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 mb-2" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span class="small fw-semibold" style="color: #f8fafc;">Bảo hành quyền truy cập trọn đời</span>
                    </div>
                    <span class="small" style="color: #94a3b8;">
                        Tổng số: <strong style="color: #67e8f9;">@Model.Count</strong> khóa học đã kích hoạt
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card card-modern border-0 shadow-sm rounded-4 p-5 text-center my-4" style="background: #ffffff;">
            <div class="py-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 shadow-sm" 
                     style="width: 90px; height: 90px; background: linear-gradient(135deg, rgba(79, 70, 229, 0.1) 0%, rgba(124, 58, 237, 0.15) 100%); color: #4f46e5;">
                    <i class="bi bi-collection-play fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2" style="color: #0f172a;">Bạn chưa có khóa học nào</h3>
                <p class="mx-auto mb-4 fs-6" style="color: #64748b; max-width: 520px; line-height: 1.6;">
                    Bạn chưa đăng ký khóa học nào trên EduFlyUp. Hãy khám phá ngay các chương trình đào tạo lập trình thực chiến (.NET 8, Clean Architecture, Web API, CSDL) để bắt đầu.
                </p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-brand rounded-pill px-4 py-3 fw-semibold shadow-glow d-inline-flex align-items-center gap-2">
                    <i class="bi bi-compass fs-5"></i>
                    <span>Khám phá danh sách khóa học ngay</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Stats & Actions Bar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-3 rounded-4" style="background: #ffffff; border: 1px solid #e2e8f0;">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(79, 70, 229, 0.1); color: #4f46e5;">
                    <i class="bi bi-check2-circle fs-5"></i>
                </div>
                <div>
                    <span class="small text-muted d-block" style="font-size: 0.78rem;">Danh sách bài học sẵn sàng</span>
                    <h6 class="fw-bold mb-0" style="color: #0f172a;">Đã sở hữu (@Model.Count khóa học)</h6>
                </div>
            </div>
            
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-brand rounded-pill btn-sm px-3 py-2 d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-circle"></i>
                <span>Đăng ký thêm khóa học khác</span>
            </a>
        </div>

        <!-- Course Cards Grid -->
        <div class="row g-4 mb-5">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-modern h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column" 
                         style="background: #ffffff; border: 1px solid #e2e8f0; transition: all 0.3s ease;">
                        
                        <!-- Thumbnail wrapper with status badge -->
                        <div class="position-relative overflow-hidden" style="height: 200px; background: #0f172a;">
                            <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80" : item.ThumbnailUrl)" 
                                 class="w-100 h-100" 
                                 alt="@item.CourseTitle" 
                                 style="object-fit: cover; transition: transform 0.4s ease;"
                                 onmouseover="this.style.transform='scale(1.05)'"
                                 onmouseout="this.style.transform='scale(1)'"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';" />
                            
                            <!-- Dark overlay gradient -->
                            <div class="position-absolute bottom-0 start-0 end-0" style="height: 60px; background: linear-gradient(to top, rgba(15, 23, 42, 0.75), transparent); pointer-events: none;"></div>

                            <!-- "Đã sở hữu" Badge -->
                            <span class="position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill small fw-bold shadow-sm d-inline-flex align-items-center gap-1"
                                  style="background: #10b981; color: #ffffff; font-size: 0.78rem; letter-spacing: 0.02em;">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>ĐÃ SỞ HỮU</span>
                            </span>

                            <!-- Lesson count on image -->
                            <span class="position-absolute bottom-0 end-0 m-3 px-2.5 py-1 rounded-pill small fw-semibold d-inline-flex align-items-center gap-1"
                                  style="background: rgba(15, 23, 42, 0.85); color: #f8fafc; font-size: 0.75rem; backdrop-filter: blur(4px);">
                                <i class="bi bi-play-circle-fill text-primary"></i>
                                <span>@item.LessonCount bài học</span>
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <!-- Meta: Enrolled Date -->
                            <div class="small mb-2 d-flex align-items-center gap-2" style="color: #64748b;">
                                <span><i class="bi bi-calendar3 me-1 text-primary"></i>Kích hoạt: @item.EnrolledAt.ToString("dd/MM/yyyy")</span>
                                <span>•</span>
                                <span class="text-success fw-semibold"><i class="bi bi-infinity me-1"></i>Trọn đời</span>
                            </div>

                            <!-- Course Title -->
                            <h5 class="fw-bold mb-2" style="color: #0f172a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem; line-height: 1.4;">
                                @item.CourseTitle
                            </h5>

                            <!-- Description -->
                            <p class="small flex-grow-1 mb-4" style="color: #64748b; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "Khóa học chất lượng cao, bài giảng trực quan, mã nguồn chi tiết tại EduFlyUp." : item.Description)
                            </p>

                            <!-- Progress status hint -->
                            <div class="p-2.5 rounded-3 mb-3 d-flex align-items-center justify-content-between" style="background: #f8fafc; border: 1px solid #f1f5f9;">
                                <span class="small fw-semibold" style="color: #334155; font-size: 0.8rem;">
                                    <i class="bi bi-mortarboard me-1 text-primary"></i>Trạng thái học
                                </span>
                                <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.15); color: #059669; font-size: 0.75rem;">
                                    Sẵn sàng học
                                </span>
                            </div>

                            <!-- Card Action Buttons -->
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                @if (item.FirstLessonId.HasValue)
                                {
                                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.FirstLessonId.Value" 
                                       class="btn btn-brand flex-grow-1 py-2.5 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2 shadow-glow">
                                        <i class="bi bi-play-circle-fill fs-6"></i>
                                        <span>Vào học ngay</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" 
                                       class="btn btn-brand flex-grow-1 py-2.5 rounded-pill fw-semibold btn-sm d-flex align-items-center justify-content-center gap-2 shadow-glow">
                                        <i class="bi bi-eye-fill fs-6"></i>
                                        <span>Vào xem khóa học</span>
                                    </a>
                                }

                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" 
                                   class="btn btn-outline-secondary rounded-pill py-2.5 px-3 btn-sm d-flex align-items-center justify-content-center" 
                                   title="Xem thông tin chi tiết khóa học">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
