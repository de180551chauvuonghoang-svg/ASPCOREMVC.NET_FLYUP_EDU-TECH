@using EduFlyUp.BusinessObjects
@using EduFlyUp.Web.Models.Instructor
@model CouponListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Mã giảm giá của tôi"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><h1 class="h3 fw-bold mb-1">Mã giảm giá của tôi</h1><p class="text-muted mb-0">Quản lý ưu đãi cho các khóa học của bạn. Mức giảm tối đa 90%.</p></div>
    <a asp-action="Create" class="btn btn-brand rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Tạo mã giảm giá</a>
</div>
<div class="card card-modern border-0 shadow-sm p-3 p-md-4 mb-4">
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div class="flex-grow-1"><label for="couponSearch" class="form-label">Tìm mã giảm giá</label><input id="couponSearch" name="search" value="@Model.Search" maxlength="100" class="form-control" placeholder="Nhập mã cần tìm" /></div>
        <button type="submit" class="btn btn-primary">Tìm kiếm</button><a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
    </form>
</div>
<div class="card card-modern border-0 shadow-sm overflow-hidden">
    <div class="p-3 border-bottom text-muted">Tổng cộng @Model.Coupons.TotalCount mã · Trang @Model.Coupons.Page/@Model.Coupons.TotalPages</div>
    @if (Model.Coupons.Items.Count == 0)
    {
        <div class="p-5 text-center"><h2 class="h5">Chưa có mã giảm giá phù hợp</h2><p class="text-muted">Tạo mã mới hoặc thay đổi từ khóa tìm kiếm.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Mã / Mức giảm</th><th scope="col">Khóa học áp dụng</th><th scope="col">Thời hạn (giờ Việt Nam)</th><th scope="col">Lượt dùng</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var coupon in Model.Coupons.Items)
            {
                <tr>
                    <td><strong class="font-monospace">@coupon.Code</strong><div class="text-success fw-semibold">Giảm @coupon.DiscountPercent%</div></td>
                    <td>@(coupon.CourseId.HasValue ? coupon.Course?.Title : "Tất cả khóa học của tôi")</td>
                    <td class="small"><div>@CouponFormModel.VietnamTime(coupon.StartDate).ToString("dd/MM/yyyy HH:mm")</div><div class="text-muted">đến @CouponFormModel.VietnamTime(coupon.EndDate).ToString("dd/MM/yyyy HH:mm")</div></td>
                    <td>@coupon.UsedCount / @coupon.MaxUsage</td>
                    <td><span class="badge @(coupon.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@CouponPresentation.Status(coupon, Model.UtcNow)</span></td>
                    <td><div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-primary" aria-label="Sửa mã @coupon.Code">Sửa</a>
                        <form asp-action="@(coupon.IsActive ? "Deactivate" : "Activate")" asp-route-id="@coupon.Id" method="post">
                            <input type="hidden" name="version" value="@CouponPresentation.Version(coupon)" />
                            <button class="btn btn-sm @(coupon.IsActive ? "btn-outline-secondary" : "btn-outline-success")" type="submit" aria-label="@(coupon.IsActive ? "Tắt" : "Bật") mã @coupon.Code">@(coupon.IsActive ? "Tắt mã" : "Bật mã")</button>
                        </form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table></div>
        <nav class="d-flex gap-2 justify-content-end p-3" aria-label="Phân trang mã giảm giá">
            @if (Model.Coupons.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Coupons.Page - 1)">Trang trước</a> }
            @if (Model.Coupons.Page < Model.Coupons.TotalPages) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Coupons.Page + 1)">Trang sau</a> }
        </nav>
    }
</div>
