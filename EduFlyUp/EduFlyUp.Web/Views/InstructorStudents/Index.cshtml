@using EduFlyUp.Web.Models.Instructor
@model EduFlyUp.BusinessObjects.InstructorStudentRoster
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Học viên — " + Model.CourseTitle; }
<div class="mb-4"><a asp-action="Courses" class="text-decoration-none">← Học viên theo khóa học</a><h1 class="h3 fw-bold mt-3">@Model.CourseTitle</h1><p class="text-muted">Danh sách ghi danh · Thời gian theo giờ Việt Nam (UTC+7)</p></div>
<div class="card card-modern border-0 shadow-sm overflow-hidden">
    <div class="p-3 border-bottom text-muted">Tổng cộng @Model.TotalCount học viên · Trang @Model.Page/@Model.TotalPages</div>
    @if (Model.Students.Count == 0)
    {
        <div class="p-5 text-center"><h2 class="h5">Chưa có học viên ghi danh</h2><p class="text-muted mb-0">Danh sách sẽ cập nhật khi khóa học có học viên đăng ký.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr>
            <th scope="col">Học viên</th><th scope="col">Email</th><th scope="col">Ngày ghi danh</th><th scope="col">Trạng thái</th><th scope="col">Ngày hoàn thành</th>
        </tr></thead><tbody>
        @foreach (var student in Model.Students)
        {
            <tr><td class="fw-semibold">@student.FullName</td><td>@(student.Email ?? "—")</td><td class="small">@InstructorReportDisplay.VietnamTime(student.EnrolledAt)</td>
                <td><span class="badge bg-secondary-subtle text-secondary">@InstructorReportDisplay.Status(student.Status)</span></td>
                <td class="small">@(student.CompletedAt.HasValue ? InstructorReportDisplay.VietnamTime(student.CompletedAt.Value) : "—")</td></tr>
        }
        </tbody></table></div>
        <nav class="d-flex gap-2 justify-content-end p-3" aria-label="Phân trang học viên">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-page="@(Model.Page - 1)" class="btn btn-sm btn-outline-secondary">Trang trước</a> }
            @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary">Trang sau</a> }
        </nav>
    }
</div>
