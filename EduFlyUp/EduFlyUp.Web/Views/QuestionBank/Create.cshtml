@model EduFlyUp.Web.Models.QuestionBank.QuestionCreateEditViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo câu hỏi mới - " + Model.Course?.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Instructor" asp-action="Dashboard" class="text-decoration-none">
                <i class="bi bi-mortarboard-fill me-1"></i>Kênh Giảng Viên
            </a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="text-decoration-none">
                Ngân hàng câu hỏi
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Tạo câu hỏi mới
        </li>
    </ol>
</nav>

<div class="row justify-content-center mb-5">
    <div class="col-lg-10">
        <div class="card card-modern brand-hero-banner p-4 border-0 shadow-sm mb-4 rounded-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <span class="badge badge-brand-soft px-3 py-1 rounded-pill fw-bold mb-2">
                        <i class="bi bi-plus-circle-fill me-1"></i>Tạo câu hỏi mới
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">Thêm Câu Hỏi Trắc Nghiệm Mới</h2>
                    <div class="text-secondary small">
                        Khóa học: <strong>@Model.Course?.Title</strong>
                    </div>
                </div>
                <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại ngân hàng</span>
                </a>
            </div>
        </div>

        <div class="card card-modern p-4 p-md-5 border-0 shadow-sm rounded-4">
            <partial name="_QuestionForm" model="Model" />
        </div>
    </div>
</div>
