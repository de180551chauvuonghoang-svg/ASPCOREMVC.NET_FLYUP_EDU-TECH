@model IEnumerable<EduFlyUp.Domain.Entities.Course>

@{
    ViewData["Title"] = "Trang Quản Trị Hệ Thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-warning me-2"></i>Bảng Điều Khiển Quản Trị (Admin)</h2>
        <p class="text-muted">Tổng quan số liệu hệ thống khóa học EduFlyUp lấy trực tiếp từ SQL Server</p>
    </div>
    <a asp-area="" asp-controller="Courses" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Thêm khóa học mới
    </a>
</div>

<!-- 3 Thẻ Thống Kê Số Liệu từ SQL Server -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-modern p-4 border-start border-primary border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">TỔNG SỐ KHÓA HỌC</span>
                    <h2 class="fw-bold text-primary mt-1 mb-0">@ViewBag.TotalCourses</h2>
                </div>
                <div class="bg-primary-subtle p-3 rounded-circle text-primary fs-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-modern p-4 border-start border-success border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">ĐÃ CÔNG KHAI</span>
                    <h2 class="fw-bold text-success mt-1 mb-0">@ViewBag.PublishedCourses</h2>
                </div>
                <div class="bg-success-subtle p-3 rounded-circle text-success fs-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-modern p-4 border-start border-info border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">TỔNG SỐ BÀI HỌC</span>
                    <h2 class="fw-bold text-info mt-1 mb-0">@ViewBag.TotalLessons</h2>
                </div>
                <div class="bg-info-subtle p-3 rounded-circle text-info fs-3">
                    <i class="bi bi-collection-play-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng Danh Sách Khóa Học Trong Database -->
<div class="card card-modern shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Danh sách Khóa học trong Database</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">ID</th>
                    <th scope="col">Tên khóa học</th>
                    <th scope="col">Cấp độ</th>
                    <th scope="col">Học phí</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col">Ngày tạo</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có khóa học nào trong cơ sở dữ liệu.</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@c.Id</td>
                            <td>
                                <span class="fw-semibold text-dark">@c.Title</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@c.Level</span>
                            </td>
                            <td>
                                @(c.Price == 0 ? "Miễn phí" : c.Price.ToString("N0") + " đ")
                            </td>
                            <td>
                                @if (c.IsPublished)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Công khai</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Bản nháp</span>
                                }
                            </td>
                            <td class="text-muted small">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
